---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShirtSvg from '../../components/proto-c/ShirtSvg.astro';
import { COLLECTION_SIZE, featured } from '../../data/collection';

const [hero, second] = featured;
if (!hero || !second) throw new Error('collection.ts: expected two featured shirts');

const lastName = (full: string): string => full.split(' ').slice(-1)[0] ?? full;

const placard = [
  `Eksponat #${hero.no}`,
  `${hero.player} · ${hero.number}`,
  `Sezon ${hero.season}${hero.occasion ? ` · ${hero.occasion}` : ''}`,
  [hero.maker, hero.matchWorn && 'koszulka meczowa', hero.signed && 'z autografem'].filter(Boolean).join(' · '),
];

const cases = [
  { no: hero.no, label: `${lastName(hero.player)} · ${hero.number}`, landing: true },
  { no: second.no, label: `${lastName(second.player)} · ${second.number}`, shirt: second },
  { no: 91, label: 'Wkrótce' },
  { no: 90, label: 'Wkrótce' },
];
---

<BaseLayout noindex title="Prototyp C – Muzeum · Coś więcej niż pasja">
  <script slot="head" is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('c-motion');
  </script>

  <main class="runway">
    <div class="stage" data-stage>
      <div class="spot" aria-hidden="true"></div>
      <a class="back" href="/">← prototypy</a>

      <header class="head">
        <p class="eyebrow">Kolekcja meczowych koszulek Wisły Kraków · {COLLECTION_SIZE} eksponatów</p>
        <h1 class="title">
          <span class="line" style="--i:0"><span class="line-in">Coś więcej</span></span>
          <span class="line" style="--i:1"><span class="line-in">niż pasja</span></span>
        </h1>
      </header>

      <div class="exhibit-slot">
        <div class="fly" data-fly>
          <div class="sway">
            <span class="hanger" aria-hidden="true"></span>
            <div class="tilt">
              <div class="flip">
                <span class="face face--front">
                  <ShirtSvg side="front" uid="ex-f" sheen />
                </span>
                <span class="face face--back">
                  <ShirtSvg side="back" uid="ex-b" name="Iliev" number={hero.number} signed={hero.signed} sheen />
                </span>
              </div>
            </div>
            <button type="button" class="flip-btn" data-flip aria-pressed="false" aria-label="Pokaż tył koszulki">
              <span class="flip-pill" aria-hidden="true">Obróć ↻</span>
            </button>
          </div>
        </div>
      </div>

      <aside class="placard" aria-label="Etykieta eksponatu">
        {placard.map((text, i) => <p class:list={['ln', { 'ln--name': i === 1 }]} style={`--i:${i}`}>{text}</p>)}
        <p class="ln ln--story" style="--i:4">{hero.story.pl}</p>
      </aside>

      <section class="gallery" aria-labelledby="gallery-title">
        <div class="gallery-head">
          <h2 id="gallery-title">Galeria</h2>
          <span>Gablota 01 – 04 / {COLLECTION_SIZE}</span>
        </div>
        <div class="cases">
          {
            cases.map((c) => (
              <article class="case">
                <div class="case-slot" data-case-slot={c.landing ? '' : undefined} data-empty={c.shirt || c.landing ? undefined : ''}>
                  {c.landing && (
                    <span class="case-fallback">
                      <ShirtSvg uid="case-1" />
                    </span>
                  )}
                  {c.shirt && <ShirtSvg uid={`case-${c.no}`} />}
                  {!c.shirt && !c.landing && <span class="soon">Wkrótce</span>}
                </div>
                <p class="case-label"><span>#{c.no}</span> {c.label}</p>
              </article>
            ))
          }
        </div>
      </section>
    </div>
  </main>

  <script>
    import { initHall } from '../../components/proto-c/hall';

    const stage = document.querySelector<HTMLElement>('[data-stage]');
    if (stage) initHall(stage);
  </script>
</BaseLayout>

<style>
  @property --p {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @keyframes progress {
    to {
      --p: 1;
    }
  }

  @keyframes rise {
    from {
      transform: translateY(108%);
      font-stretch: 100%;
    }
    to {
      transform: none;
      font-stretch: 75%;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      translate: 0 0.6rem;
    }
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 -7%;
    }
  }

  @keyframes sway {
    0%,
    100% {
      rotate: -0.6deg;
      translate: 0 0;
    }
    50% {
      rotate: 0.6deg;
      translate: 0 -5px;
    }
  }

  /* ---------- static / mobile-first base ---------- */
  .stage {
    --mx: 0;
    --my: 0;
    --dx: 0;
    --dy: 0;
    --s: 1;
    --e: clamp(0, calc((var(--p) - 0.08) / 0.84), 1);
    --fade: clamp(0, calc(1 - var(--e) * 2.2), 1);

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(16rem, 1fr) auto auto;
    min-height: 100svh;
    padding-inline: var(--gutter);
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 50% 0%, var(--c-navy) 0%, transparent 70%),
      linear-gradient(var(--c-ink), var(--c-navy-deep) 85%, var(--c-ink));
  }

  .back {
    position: absolute;
    z-index: 6;
    top: 1rem;
    left: var(--gutter);
    font: var(--fs-xs) var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    text-decoration: none;

    &:hover {
      color: var(--accent-2);
    }
  }

  .spot {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;

    &::before {
      content: '';
      position: absolute;
      left: 50%;
      top: 45%;
      width: 120vmax;
      height: 120vmax;
      margin: -60vmax 0 0 -60vmax;
      background: radial-gradient(closest-side, rgb(255 244 222 / 0.17), rgb(120 160 210 / 0.06) 45%, transparent 72%);
      transform: translate3d(calc(var(--mx) * 36vw), calc(var(--my) * 28svh), 0);
      will-change: transform;
    }

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(rgb(255 240 210 / 0.07), transparent 75%);
      clip-path: polygon(44% 0, 56% 0, 92% 100%, 8% 100%);
    }
  }

  .head {
    position: relative;
    z-index: 2;
    padding-top: 3.2rem;
    opacity: var(--fade);
    translate: 0 calc((1 - var(--fade)) * -24px);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.9rem;
    max-width: 34ch;
    font: var(--fs-xs) / 1.5 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);
    animation: fade-up 0.9s var(--ease-out) 0.1s both;

    &::before {
      content: '';
      flex: none;
      width: 2rem;
      height: 1px;
      background: currentcolor;
    }
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 0.9rem + 12.5vw, 9.5rem);
    font-stretch: 75%;
    line-height: 1;
    text-wrap: balance;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-block: 0.06em;
    white-space: nowrap;

    &:first-child {
      font-weight: 300;
    }

    &:last-child {
      font-weight: 800;
      color: var(--c-red-bright);
    }
  }

  .line-in {
    display: block;
    font-stretch: 75%;
    animation: rise 1.3s var(--ease-out) calc(var(--i) * 140ms + 200ms) both;
  }

  /* ---------- exhibit ---------- */
  .exhibit-slot {
    position: relative;
    z-index: 4;
    min-height: 0;
    container-type: size;
    display: grid;
    place-items: center;
    pointer-events: none;

    &::before {
      content: '';
      position: absolute;
      inset: 4% 8%;
      background: radial-gradient(closest-side, rgb(255 236 200 / 0.1), transparent);
      opacity: var(--fade);
    }
  }

  .fly {
    position: relative;
    width: min(88cqw, calc(88cqh * 5 / 6));
    aspect-ratio: 5 / 6;
    transform: translate(calc(var(--dx) * var(--e) * 1px), calc(var(--dy) * var(--e) * 1px))
      scale(calc(1 + (var(--s) - 1) * var(--e)));
  }

  .sway {
    position: relative;
    width: 100%;
    height: 100%;
    transform-origin: 50% -30%;
    pointer-events: auto;
    animation: sway 7s ease-in-out infinite;
  }

  .hanger {
    position: absolute;
    left: 50%;
    bottom: 94%;
    width: 1px;
    height: 100svh;
    background: linear-gradient(transparent, var(--c-gold));
    opacity: calc(var(--fade) * 0.8);

    &::after {
      content: '';
      position: absolute;
      left: -3px;
      bottom: -2px;
      width: 7px;
      height: 7px;
      border: 1px solid var(--c-gold);
      border-radius: 50%;
    }
  }

  .tilt {
    width: 100%;
    height: 100%;
    perspective: 1100px;
    transform-style: preserve-3d;
    transform-origin: 50% 6%;
    animation: arrive 1.4s var(--ease-out) 0.3s both;
  }

  .flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transform-origin: 50% 6%;
    transform: rotateX(calc(var(--my) * -9deg)) rotateY(calc(var(--mx) * 14deg));
  }

  .face {
    position: absolute;
    inset: 0;
    display: block;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .face--front {
    transform: rotateY(0deg);
  }

  .face--back {
    transform: rotateY(180deg);
  }

  /* Tilt rotates .flip, flip rotates the faces – the two never fight. */
  .stage[data-flipped='true'] .face--front {
    transform: rotateY(-180deg);
  }

  .stage[data-flipped='true'] .face--back {
    transform: rotateY(0deg);
  }

  .flip-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    align-items: end;
    justify-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    &:focus-visible {
      outline-offset: 6px;
    }
  }

  .flip-pill {
    margin-bottom: -0.4rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgb(210 179 101 / 0.5);
    border-radius: 99px;
    background: rgb(5 15 26 / 0.7);
    font: var(--fs-xs) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    opacity: clamp(0, calc(var(--fade) * 1.5), 1);
    transition: background var(--dur-fast);
  }

  .flip-btn:hover .flip-pill {
    background: rgb(5 15 26 / 0.95);
  }

  /* ---------- museum label ---------- */
  .placard {
    position: relative;
    z-index: 3;
    padding: 0.8rem 0 1.2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--fg-muted);
    opacity: var(--fade);
    translate: 0 calc((1 - var(--fade)) * -24px);

    &::before {
      content: '';
      display: block;
      height: 1px;
      margin-bottom: 0.7rem;
      background: var(--c-gold);
      transform-origin: left;
      animation: draw 1.1s var(--ease-out) 0.7s both;
    }
  }

  .ln {
    margin: 0;
    max-width: 46ch;
    animation: fade-up 0.8s var(--ease-out) calc(var(--i) * 110ms + 900ms) both;
  }

  .ln:first-of-type {
    color: var(--accent-2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ln--name {
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--fg);
  }

  .ln--story {
    margin-top: 0.55rem;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
  }

  @media (max-height: 40rem) {
    .ln--story {
      display: none;
    }
  }

  /* ---------- gallery (display cases) ---------- */
  .gallery {
    grid-column: 1 / -1;
    z-index: 3;
    margin-inline: calc(var(--gutter) * -1);
    padding-bottom: var(--gutter);
  }

  .gallery-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 var(--gutter) 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--c-gold);
    font: var(--fs-xs) var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-2);

    & h2 {
      margin: 0;
      font: inherit;
      font-weight: 700;
    }
  }

  .cases {
    position: relative;
    display: flex;
    gap: 0.9rem;
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }

  .case {
    flex: 0 0 clamp(8.5rem, 38vw, 15rem);
    scroll-snap-align: start;
  }

  .case-slot {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 6;
    padding: 8%;
    border: 1px solid rgb(210 179 101 / 0.4);
    background:
      linear-gradient(155deg, rgb(255 255 255 / 0.09), transparent 38%),
      radial-gradient(closest-side, rgb(255 236 200 / 0.08), transparent),
      var(--c-navy-deep);
    overflow: hidden;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 40%, rgb(255 255 255 / 0.07) 48%, transparent 56%);
      pointer-events: none;
    }

    &[data-empty] {
      border-style: dashed;
      background: transparent;
    }
  }

  .soon,
  .case-label {
    font: var(--fs-xs) var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .case-label {
    margin: 0.6rem 0 0;

    & span {
      color: var(--accent-2);
    }
  }

  /* ---------- motion layout: sticky stage + scroll transition ---------- */
  :global(.c-motion) .runway {
    height: 190svh;
  }

  :global(.c-motion) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  :global(.c-motion) .gallery {
    position: absolute;
    inset: auto 0 0;
    margin-inline: 0;
    background: linear-gradient(transparent, rgb(5 15 26 / 0.92) 28%);
    padding-top: 1.5rem;
    transform: translateY(calc((1 - var(--e)) * 100%));
  }

  :global(.c-motion) .case-fallback {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    :global(.c-motion) .stage {
      animation: progress linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 90svh;
    }
  }

  .case-fallback {
    display: block;
    width: 100%;
  }

  /* ---------- desktop ---------- */
  @media (min-width: 62rem) {
    .stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1fr);
    }

    .head {
      grid-column: 1 / -1;
      padding-top: 3.5rem;
    }

    .exhibit-slot {
      grid-column: 2;
      grid-row: 2;
    }

    .placard {
      grid-column: 3;
      grid-row: 2;
      align-self: end;
      justify-self: end;
      width: min(100%, 24rem);
      padding-bottom: 2rem;
    }

    .gallery {
      grid-row: 3;
    }

    :global(.c-motion) .stage {
      grid-template-rows: auto minmax(0, 1fr);
    }

    .case {
      flex-basis: clamp(10rem, 16vw, 15rem);
    }
  }

  /* ---------- reduced motion: static, instant flip ---------- */
  @media (prefers-reduced-motion: reduce) {
    .sway,
    .tilt,
    .line-in,
    .eyebrow,
    .ln,
    .placard::before {
      animation: none;
    }

    .spot::before {
      will-change: auto;
    }
  }
</style>
