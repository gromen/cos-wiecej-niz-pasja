---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/proto-a/Hero.astro';
import Latest from '../../components/proto-a/Latest.astro';
---

<BaseLayout
  noindex
  title="Ściana · prototyp A – Coś więcej niż pasja"
  description="Prototyp A: interaktywna ściana 86 meczowych koszulek Wisły Kraków."
>
  <!-- Runs before first paint: the intro plays once per session, never with reduced motion (?intro replays it). -->
  <script is:inline slot="head">
    (() => {
      try {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const forced = /[?&]intro\b/.test(location.search);
        if (!reduce && (forced || !sessionStorage.getItem('cwnp-a-intro'))) {
          document.documentElement.dataset.intro = 'on';
        }
      } catch {
        /* storage blocked – skip the intro */
      }
    })();
  </script>
  <main>
    <Hero />
    <Latest />
  </main>
</BaseLayout>
