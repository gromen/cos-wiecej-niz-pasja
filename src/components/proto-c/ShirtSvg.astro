---
/**
 * Placeholder shirt illustration (no club crest, no sponsor logos).
 * Fixed 5:6 box (viewBox 400x480) – a real <Picture> later must fill the same
 * wrapper with `width: 100%; height: 100%; object-fit: contain`.
 */
interface Props {
  side?: 'front' | 'back';
  color?: string;
  name?: string;
  number?: number | string;
  signed?: boolean;
  /** Moving specular highlight driven by --mx / --my on an ancestor. */
  sheen?: boolean;
  /** Unique id prefix – several instances live on one page. */
  uid?: string;
}

const {
  side = 'front',
  color = '#c6102e',
  name = '',
  number = '',
  signed = false,
  sheen = false,
  uid = 'shirt',
} = Astro.props;

const BODY =
  'M135 24 L60 54 L8 150 L62 176 L92 130 L92 450 Q200 470 308 450 L308 130 L338 176 L392 150 L340 54 L265 24 Q200 66 135 24 Z';

const star = (cx: number, cy: number, outer: number, inner: number): string =>
  Array.from({ length: 10 }, (_, i) => {
    const angle = -Math.PI / 2 + (i * Math.PI) / 5;
    const radius = i % 2 === 0 ? outer : inner;
    return `${(cx + Math.cos(angle) * radius).toFixed(1)},${(cy + Math.sin(angle) * radius).toFixed(1)}`;
  }).join(' ');

// Pinstripe sash: edges + hairlines, parallel diagonals across the torso.
const stripes = [0, 0.25, 0.5, 0.75, 1].map((t) => {
  const y = 92 + 36 * t;
  const edge = t === 0 || t === 1;
  return { d: `M80 ${y} L320 ${y + 293}`, w: edge ? 2.4 : 0.9, o: edge ? 0.95 : 0.55 };
});

const label = String(name).toUpperCase();
const neckBack = 'M135 24 Q200 46 265 24';
const neckFront = 'M135 24 Q200 70 265 24';
---

<svg
  class="shirt"
  viewBox="0 0 400 480"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  style={`--dir:${side === 'back' ? -1 : 1}`}
>
  <defs>
    <clipPath id={`${uid}-clip`}><path d={BODY}></path></clipPath>
    <linearGradient id={`${uid}-edge`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0.38"></stop>
      <stop offset="0.2" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="0.8" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0.38"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-fold`} x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#000" stop-opacity="0.13"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id={`${uid}-sheen`}>
      <stop offset="0" stop-color="#fff" stop-opacity="0.5"></stop>
      <stop offset="0.45" stop-color="#fff" stop-opacity="0.14"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <pattern id={`${uid}-weave`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="4" height="1" fill="#000" opacity="0.1"></rect>
    </pattern>
  </defs>

  <path d={BODY} fill={color}></path>

  <g clip-path={`url(#${uid}-clip)`}>
    <rect width="400" height="480" fill={`url(#${uid}-weave)`}></rect>
    <rect x="130" y="40" width="46" height="420" fill={`url(#${uid}-fold)`}></rect>
    <rect x="236" y="60" width="40" height="400" fill={`url(#${uid}-fold)`}></rect>
    {
      side === 'front' && (
        <g fill="none" stroke="#fff" stroke-linecap="butt">
          <path d="M80 92 L320 385 L320 420 L80 128 Z" fill="#fff" fill-opacity="0.06" stroke="none"></path>
          {stripes.map((s) => (
            <path d={s.d} stroke-width={s.w} opacity={s.o}></path>
          ))}
        </g>
      )
    }
    <rect width="400" height="480" fill={`url(#${uid}-edge)`}></rect>
    {
      sheen && (
        <circle class="sheen" cx="200" cy="240" r="190" fill={`url(#${uid}-sheen)`}></circle>
      )
    }
  </g>

  <!-- armhole seams -->
  <path d="M135 24 L92 130 M265 24 L308 130" stroke="#000" stroke-opacity="0.25" stroke-width="1.5" fill="none"></path>

  <!-- cuffs + hem -->
  <path d="M8 150 L62 176 L70 164 L15 138 Z M392 150 L338 176 L330 164 L385 138 Z" fill="#fafafa"></path>
  <path d="M92 441 Q200 461 308 441" stroke="#fafafa" stroke-width="3" fill="none" opacity="0.9"></path>

  <!-- collar -->
  <path
    d={`${side === 'front' ? neckFront : neckBack} Z`}
    fill="#000"
    fill-opacity="0.4"
  ></path>
  <path
    d={side === 'front' ? neckFront : neckBack}
    stroke="#fafafa"
    stroke-width="9"
    fill="none"
    stroke-linecap="round"></path>

  {
    side === 'front' ? (
      <polygon points={star(268, 104, 14, 5.6)} fill="#fafafa"></polygon>
    ) : (
      <g class="back" fill="#fafafa" text-anchor="middle">
        <text
          x="200"
          y="108"
          font-size="30"
          font-weight="800"
          letter-spacing="3"
          textLength={label.length > 7 ? 190 : undefined}
          lengthAdjust="spacingAndGlyphs"
        >
          {label}
        </text>
        <text x="200" y="298" font-size="200" font-weight="800" textLength="170" lengthAdjust="spacingAndGlyphs">
          {number}
        </text>
        {
          signed && (
            <g transform="rotate(-9 200 365)">
              <path
                class="sig"
                pathLength="1"
                d="M118 372 C132 340 150 318 160 330 C170 344 140 372 160 366 C190 356 196 330 206 340 C216 352 196 372 214 366 C240 356 252 334 262 346 C270 356 258 366 282 352 M112 388 C170 372 240 382 300 366"
                fill="none"
                stroke="#f4efe0"
                stroke-width="3.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </g>
          )
        }
      </g>
    )
  }
</svg>

<style>
  .shirt {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .back text {
    font-family: var(--font-display);
    font-stretch: 75%;
  }

  .sheen {
    transform: translate(calc(var(--mx, 0) * var(--dir, 1) * 150px), calc(var(--my, 0) * 170px));
  }

  .sig {
    stroke-dasharray: 1 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  :global([data-flipped='true']) .sig {
    opacity: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.5s var(--ease-in-out) 0.6s;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-flipped='true']) .sig {
      transition: none;
    }
  }
</style>
