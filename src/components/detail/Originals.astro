---
/**
 * „Zdjęcia oryginalne” – the untouched Instagram photos (proof of authenticity).
 * A scroll-snap strip of thumbnails; each opens a fullscreen <dialog> viewer
 * (pinch / double-tap zoom, swipe or ←/→ between photos) wired in ./originals.ts.
 * The viewer's large renditions are lazy inside the closed dialog → fetched on open only.
 * Renders nothing for shirts without `originals` (drafts).
 */
import { Picture } from 'astro:assets';
import type { ShirtData } from '../../lib/shirts';
import { t } from './copy';

interface Props {
  shirt: ShirtData;
}

const { shirt } = Astro.props;
const originals = shirt.originals ?? [];
const total = originals.length;
---

{
  total > 0 && (
    <section class="originals" aria-labelledby="originals-title" data-originals>
      <div class="head">
        <h2 id="originals-title" class="kicker">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="6" width="18" height="14" rx="2" />
            <circle cx="12" cy="13" r="3.6" />
            <path d="M8.5 6l1.4-2.2h4.2L15.5 6" />
          </svg>
          {t.originalsTitle}
        </h2>
        <p class="lead">{t.originalsLead}</p>
      </div>

      <ul class="strip" data-local-nav>
        {originals.map((photo, index) => (
          <li class="item">
            <figure>
              <button type="button" class="thumb" data-original-open={index} aria-haspopup="dialog">
                <Picture
                  src={photo}
                  alt={t.originalAlt(index, shirt.player, shirt.number)}
                  widths={[320, 480, 640, 880]}
                  sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 40vw, 72vw"
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                />
                <span class="thumb-zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
                  </svg>
                </span>
              </button>
              <figcaption>{t.originalCaption(index)}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      {shirt.instagram && (
        <a class="ig" href={shirt.instagram} target="_blank" rel="noopener">
          {t.igPost}
          <span aria-hidden="true">↗</span>
          <span class="visually-hidden">{t.newTab}</span>
        </a>
      )}

      <dialog class="viewer" data-viewer data-local-nav aria-label={t.viewerTitle}>
        <div class="viewer-bar">
          <p class="viewer-count">
            <b data-viewer-index>1</b>&nbsp;/&nbsp;{total}
          </p>
          <button type="button" class="viewer-btn viewer-close" data-viewer-close>
            {t.viewerClose}
            <span aria-hidden="true">✕</span>
          </button>
        </div>

        <div class="viewer-stage" data-viewer-stage>
          {originals.map((photo, index) => (
            <figure class="slide" data-slide={index} hidden>
              <div class="zoom" data-zoom>
                <Picture
                  src={photo}
                  alt={t.originalAlt(index, shirt.player, shirt.number)}
                  widths={[720, 1080, 1440]}
                  sizes="min(100vw, 82svh)"
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </div>
              <figcaption>{t.originalCaption(index)}</figcaption>
            </figure>
          ))}

          {total > 1 && (
            <>
              <button type="button" class="viewer-btn viewer-nav viewer-nav--prev" data-viewer-prev>
                <span aria-hidden="true">←</span>
                <span class="visually-hidden">{t.viewerPrev}</span>
              </button>
              <button type="button" class="viewer-btn viewer-nav viewer-nav--next" data-viewer-next>
                <span aria-hidden="true">→</span>
                <span class="visually-hidden">{t.viewerNext}</span>
              </button>
            </>
          )}
        </div>

        <p class="viewer-hint">
          <span class="hint-touch">{t.viewerHintTouch}</span>
          <span class="hint-keys">{t.viewerHintKeys}</span>
        </p>
      </dialog>
    </section>
  )
}

<style>
  .originals {
    --hair: rgb(210 179 101 / 0.4);

    display: grid;
    gap: 1.25rem;
    padding: clamp(2.5rem, 8vw, 5rem) var(--gutter);
    border-block-start: 1px solid var(--line);
  }

  .head {
    display: grid;
    gap: 0.6rem;
    max-inline-size: 40rem;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-gold);

    & svg {
      inline-size: 1.15em;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linejoin: round;
    }
  }

  .lead {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg-muted);
  }

  /* Horizontal strip; bleeds to the screen edge on phones. */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 22rem);
    gap: 0.9rem;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0.25rem var(--gutter) 0.75rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .item {
    scroll-snap-align: start;
  }

  figure {
    display: grid;
    gap: 0.55rem;
    margin: 0;
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .thumb {
    position: relative;
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: calc(var(--radius) * 2);
    background: var(--bg-raised);
    box-shadow:
      inset 0 0 0 1px var(--hair),
      0 0.6rem 1.6rem rgb(0 0 0 / 0.25);
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;

    & :global(picture),
    & :global(img) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    /* Hairline frame drawn above the photo. */
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgb(250 250 250 / 0.12);
      pointer-events: none;
    }

    &:focus-visible {
      outline: 2px solid var(--c-gold);
      outline-offset: 3px;
    }
  }

  .thumb-zoom {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-end: 0.6rem;
    display: grid;
    place-items: center;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border-radius: 50%;
    background: rgb(10 10 12 / 0.55);
    color: var(--c-white);
    backdrop-filter: blur(4px);

    & svg {
      inline-size: 1.1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }

  .ig {
    justify-self: start;
    display: inline-flex;
    gap: 0.5em;
    padding-block: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-gold);
    text-decoration: none;
    border-block-end: 1px solid var(--hair);
    transition: border-color var(--dur-fast);

    &:hover {
      border-block-end-color: currentColor;
    }
  }

  /* ---------- fullscreen viewer ---------- */
  .viewer {
    inline-size: 100%;
    max-inline-size: none;
    block-size: 100dvh;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(8 6 8 / 0.97);
    color: var(--c-white);
    overscroll-behavior: contain;

    &[open] {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }

    &::backdrop {
      background: rgb(0 0 0 / 0.85);
    }
  }

  :global(html:has(.viewer[open])) {
    overflow: hidden;
  }

  /* No showModal() (old Safari renders a closed <dialog>'s contents inline): the thumbnails
     open the photo in a new tab instead (originals.ts). */
  :global(:root[data-no-dialog]) .viewer {
    display: none;
  }

  .viewer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .viewer-count {
    margin: 0;
  }

  .viewer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgb(250 250 250 / 0.35);
    border-radius: 99px;
    background: rgb(20 20 24 / 0.6);
    color: inherit;
    font: inherit;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;

    &:hover {
      background: rgb(250 250 250 / 0.12);
    }

    &:focus-visible {
      outline: 2px solid var(--c-gold);
      outline-offset: 2px;
    }
  }

  .viewer-stage {
    position: relative;
    overflow: hidden;
    /* Gestures are ours: pinch, pan and swipe drive the transform below. */
    touch-action: none;
    user-select: none;
  }

  .slide {
    position: absolute;
    inset: 0;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.5rem;
    padding: 0 var(--gutter) 0.5rem;

    &[hidden] {
      display: none;
    }

    & figcaption {
      text-align: center;
      color: rgb(250 250 250 / 0.7);
    }
  }

  .zoom {
    min-block-size: 0;
    transform-origin: 50% 50%;
    cursor: zoom-in;

    &.is-zoomed {
      cursor: grab;
    }

    &.is-dragging {
      cursor: grabbing;
    }

    & :global(picture),
    & :global(img) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: contain;
      -webkit-user-drag: none;
      pointer-events: none;
    }
  }

  .viewer-nav {
    position: absolute;
    inset-block-start: 50%;
    translate: 0 -50%;
    padding: 0;
    font-size: 1.1rem;
  }

  .viewer-nav--prev {
    inset-inline-start: 0.5rem;
  }

  .viewer-nav--next {
    inset-inline-end: 0.5rem;
  }

  .viewer-hint {
    margin: 0;
    padding: 0.5rem var(--gutter) max(0.75rem, env(safe-area-inset-bottom));
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-align: center;
    color: rgb(250 250 250 / 0.6);
  }

  .hint-keys {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hint-touch {
      display: none;
    }

    .hint-keys {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .zoom.is-animating {
      transition: transform 220ms var(--ease-out);
    }

    .viewer[open] {
      animation: viewer-in 200ms var(--ease-out);
    }

    .thumb :global(img) {
      transition: scale var(--dur) var(--ease-out);
    }

    .thumb:hover :global(img) {
      scale: 1.03;
    }
  }

  @keyframes viewer-in {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 40rem) {
    .strip {
      grid-auto-columns: min(40vw, 22rem);
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }

    .slide {
      padding-inline: 4.5rem;
    }

    .viewer-nav--prev {
      inset-inline-start: 1rem;
    }

    .viewer-nav--next {
      inset-inline-end: 1rem;
    }
  }

  @media (min-width: 60rem) {
    .originals {
      max-inline-size: 72rem;
      margin-inline: auto;
      box-sizing: content-box;
    }
  }
</style>
