---
/**
 * One collection card, drawn as a locker of the „Czerwona szatnia”: stencilled number above
 * the door, a recess with vents and a peg, the shirt on its hanger, name plate below.
 * Everything the client filter needs lives in data-* attributes, so the dataset is never
 * duplicated as JSON.
 *
 * `.card__visual` is the shared element morphing into the detail page
 * (view-transition-name from shirtTransitionName). It is a 5:6 box: a real cut-out
 * (`data.images.front/back`) renders as <Picture> filling it; a placeholder (draft) is the
 * white outline from the page sprite (#shirt-sym-outline in <CollectionResults>); a described
 * shirt without photos falls back to a <ShirtUse> from <ShirtSymbols>.
 */
import { Picture } from 'astro:assets';
import ShirtUse from '../shirt/ShirtUse.astro';
import { VIEWBOX } from '../shirt/geometry';
import {
  colorLabel,
  kindLabel,
  lastName,
  shirtHref,
  shirtPalette,
  shirtTransitionName,
  statusLabel,
  type ShirtEntry,
} from '../../lib/shirts';
import { fold } from './search';
import { eraOf } from './model';
import type { CollectionStrings } from './strings';

interface Props {
  shirt: ShirtEntry;
  /** Position in the default order („najnowsze w kolekcji”). */
  order: number;
  strings: CollectionStrings['card'];
  lang: CollectionStrings['lang'];
  /** First visible row: eager front image (no lazy-load delay). */
  eager?: boolean;
  /** Kept for API compatibility: forces an eager front image (no fetchpriority hint). */
  priority?: boolean;
}

const { shirt, order, strings, lang, eager = false, priority = false } = Astro.props;
const { id, data } = shirt;
const palette = shirtPalette[data.color];
const vtName = shirtTransitionName(id);

const unknownPlayer = /^do uzupełnienia$/i.test(data.player.trim());
const surname = unknownPlayer ? strings.unknownPlayer : lastName(data.player);
const firstNames = unknownPlayer ? '' : data.player.slice(0, data.player.length - surname.length).trim();
const fullName = unknownPlayer ? strings.unknownPlayerFull : data.player;

const meta = data.draft
  ? [colorLabel[data.color][lang], data.season ?? strings.unknownSeason]
  : [data.season ?? strings.unknownSeason, data.competition ?? kindLabel[data.kind][lang]];

const front = data.images?.front;
const back = data.images?.back;
const hasBack = !data.draft;
const isPhoto = Boolean(front);
/** Touch screens have no hover: a small button flips photo cards to the back. */
const canFlip = Boolean(front && back);
const source = isPhoto ? strings.photo : strings.illustration;
/** Tag in the locker: the source for described shirts, „do uzupełnienia” for placeholders. */
const tag = data.draft ? strings.draft : source;
const srLabel = [fullName, `${strings.number} ${data.number}`, source.toLowerCase(), data.draft && strings.draft]
  .filter(Boolean)
  .join(', ');
// The shirt is ~76% of the card; grid: 2 → 3 → 4 → 5 columns.
const sizes = '(min-width: 96rem) 15vw, (min-width: 64rem) 19vw, (min-width: 40rem) 26vw, 38vw';
const widths = [200, 320, 480, 640];
const loading = eager || priority ? 'eager' : 'lazy';
---

<li
  class="card"
  data-card
  data-era={eraOf(data.seasonStart)}
  data-kind={data.kind}
  data-color={data.color}
  data-status={data.status}
  data-signed={data.signed ? '1' : '0'}
  data-draft={data.draft ? '1' : '0'}
  data-number={data.number}
  data-season={data.seasonStart ?? ''}
  data-order={order}
  data-search={unknownPlayer ? '' : fold(data.player)}
  data-photo={isPhoto ? '1' : '0'}
>
  <a class="card__link" href={shirtHref(id, lang)}>
    <span class="card__plate" aria-hidden="true">
      <span class="card__no">{data.number}</span>
    </span>

    <div class="card__cell">
      <span class="card__vents" aria-hidden="true"></span>
      <span class="card__peg" aria-hidden="true"></span>
      <div class="card__hang">
        <svg class="card__hanger" viewBox="0 0 120 40" aria-hidden="true" focusable="false">
          <path d="M60 2 v6 q0 5 -5 5 M60 13 L8 36 Q4 38 8 38 H112 Q116 38 112 36 L60 13"></path>
        </svg>
        <div class="card__visual" data-vt={vtName} style={`view-transition-name: ${vtName}`}>
          <div class="card__face card__face--front">
            {
              front ? (
                <Picture
                  src={front}
                  alt=""
                  widths={widths}
                  sizes={sizes}
                  formats={['avif']}
                  fallbackFormat="webp"
                  loading={loading}
                  decoding="async"
                />
              ) : data.draft ? (
                <svg class="card__outline" viewBox={VIEWBOX} aria-hidden="true" focusable="false">
                  <use href="#shirt-sym-outline"></use>
                </svg>
              ) : (
                <ShirtUse color={palette.body} trim={palette.trim} />
              )
            }
          </div>
          {
            hasBack && (
              <div class="card__face card__face--back" data-back-pending={back ? '' : undefined}>
                {back ? (
                  /* Inert until the first hover / focus / flip tap (collection.ts clones it),
                     so the grid never downloads backs nobody looks at. */
                  <template data-back>
                    <Picture
                      src={back}
                      alt=""
                      widths={widths}
                      sizes={sizes}
                      formats={['avif']}
                      fallbackFormat="webp"
                      loading="eager"
                      decoding="async"
                    />
                  </template>
                ) : (
                  <ShirtUse
                    side="back"
                    color={palette.body}
                    trim={palette.trim}
                    name={surname}
                    number={data.number}
                    signed={data.signed}
                  />
                )}
              </div>
            )
          }
        </div>
      </div>
      {
        data.signed && (
          <svg class="card__star" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polygon points="12,1.5 14.9,8.6 22.5,9.2 16.7,14.2 18.5,21.6 12,17.6 5.5,21.6 7.3,14.2 1.5,9.2 9.1,8.6" />
          </svg>
        )
      }
      <span class={`card__tag card__tag--${isPhoto ? 'photo' : 'art'}`} aria-hidden="true">{tag}</span>
    </div>

    <div class="card__body">
      <h3 class="card__name">
        <span class="visually-hidden">{srLabel}</span>
        <span aria-hidden="true">
          {firstNames && <span class="card__first">{firstNames}</span>}
          <span class="card__last">{surname}</span>
        </span>
      </h3>
      <p class="card__meta">{meta.join(' · ')}</p>
      {
        (data.signed || !data.draft) && (
          <ul class="card__badges">
            {data.signed && <li class="badge badge--signed">★ {strings.signed}</li>}
            {!data.draft && <li class={`badge badge--${data.status}`}>{statusLabel[data.status][lang]}</li>}
          </ul>
        )
      }
    </div>
  </a>
  {
    canFlip && (
      <button type="button" class="card__flip" data-card-flip aria-pressed="false" hidden>
        <span class="visually-hidden">
          {strings.flip}: {fullName}
        </span>
        <span class="card__flip-icon" aria-hidden="true">
          ↻
        </span>
      </button>
    )
  }
</li>

<style>
  .card {
    /* Locker geometry, in units of the card's own width (resolved where used, inside the card). */
    --pad: 6cqi;
    --plate: 16cqi;
    --plate-gap: 3cqi;
    /* Recess: 5 / 6.4 of the padded width. */
    --cell: calc((100cqi - 2 * var(--pad)) * 1.28);

    position: relative;
    /* Grid sets --cols / --body-h; here 100cqi = grid width → exact placeholder height. */
    container-type: inline-size;
    content-visibility: auto;
    contain-intrinsic-block-size: auto calc(100cqi / var(--cols, 2) * 1.49 + var(--body-h, 6.5rem));
    view-transition-class: collection-card;
    /* Hairline seams: each locker draws its right / bottom edge, the bank its top / left. */
    border-inline-end: 1px solid var(--line);
    border-block-end: 1px solid var(--line);

    &[hidden] {
      display: none;
    }
  }

  .card__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    block-size: 100%;
    padding: var(--pad) var(--pad) 7cqi;
    color: var(--c-white);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur) var(--ease-out);

    /* content-visibility implies paint containment → keep the ring inside the box. */
    &:focus-visible {
      outline: 2px solid var(--c-white);
      outline-offset: -4px;
    }
  }

  /* Stencilled number above the door: a bridge cut through the middle like a real stencil. */
  .card__plate {
    display: flex;
    align-items: end;
    block-size: var(--plate);
    margin-block-end: var(--plate-gap);
  }

  .card__no {
    font-family: var(--font-display);
    font-size: 19cqi;
    font-weight: 900;
    font-stretch: 125%;
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: rgb(250 250 250 / 0.88);
    mask: linear-gradient(#000 0 46%, transparent 46% 55%, #000 55%);
    transition: color var(--dur-fast);
  }

  /* The locker interior: darker recess, vents on top, peg in the middle. */
  .card__cell {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: start center;
    block-size: var(--cell);
    overflow: clip;
    border-radius: 2px;
    background:
      radial-gradient(80% 55% at 50% 45%, rgb(255 255 255 / 0.05), transparent 70%),
      linear-gradient(rgb(0 0 0 / 0.28), rgb(0 0 0 / 0.14) 30%, rgb(0 0 0 / 0.22));
    box-shadow:
      inset 0 0.6rem 1.2rem -0.4rem rgb(0 0 0 / 0.45),
      inset 0 0 0 1px rgb(0 0 0 / 0.18);
  }

  .card__vents {
    position: absolute;
    inset-block-start: 2.5cqi;
    inset-inline: 30%;
    block-size: 4cqi;
    border-radius: 1px;
    background: repeating-linear-gradient(180deg, rgb(0 0 0 / 0.35) 0 1.2cqi, transparent 1.2cqi 2cqi);
    opacity: 0.7;
  }

  .card__peg {
    position: absolute;
    z-index: 2;
    /* Sits in the hanger's hook (hook top ≈ hang top + 0.8cqi). */
    inset-block-start: 10cqi;
    inset-inline-start: 50%;
    inline-size: 4cqi;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #fff, #c9c9c9 60%, #8d8d8d);
    box-shadow: 0 0.15rem 0.3rem rgb(0 0 0 / 0.4);
  }

  /* Hanger + shirt swing together from the peg. */
  .card__hang {
    position: relative;
    display: grid;
    justify-items: center;
    inline-size: 86%;
    /* 8 + hanger 16 − 2.3 overlap + shirt 90.8 ≈ 112.5cqi ≤ recess 112.6cqi – no clipping. */
    margin-block-start: 8cqi;
    transform-origin: 50% 0;
  }

  .card__hanger {
    inline-size: 64%;
    margin-block-end: -3%;
    overflow: visible;
    fill: none;
    stroke: rgb(250 250 250 / 0.7);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 5:6 box – <Picture>/<svg> fill it. */
  .card__visual {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 5 / 6;
    perspective: 900px;
    /* `exhibit` too: the detail page's shared-element timing targets that class. */
    view-transition-class: collection-shirt exhibit;
  }

  .card__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    transition: transform calc(var(--dur) * 1.5) var(--ease-out) 60ms;

    :global(img),
    :global(picture),
    :global(svg) {
      display: block;
      inline-size: 100%;
      block-size: 100%;
      object-fit: contain;
    }
  }

  .card__face--back {
    transform: rotateY(180deg);
  }

  /* Only the few real cut-outs cast a shadow (no filter on the many outline drawings). */
  .card[data-photo='1'] .card__face :global(img) {
    filter: drop-shadow(0 0.6rem 0.8rem rgb(0 0 0 / 0.35));
  }

  /* Placeholders: chalk-white outline drawing of the shirt (strokes live in the sprite). */
  .card__outline {
    overflow: visible;
    color: var(--c-white);
    opacity: 0.85;
  }

  .card__star {
    position: absolute;
    inset-block-start: 3.5cqi;
    inset-inline-end: 4cqi;
    inline-size: 9cqi;
    fill: var(--c-gold);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4));
  }

  /* Tag in the locker's bottom-left corner: real photo / illustration / „do uzupełnienia”. */
  .card__tag {
    position: absolute;
    inset-block-end: 4cqi;
    inset-inline-start: 4cqi;
    max-inline-size: calc(100% - 8cqi - 2.75rem);
    padding: 0.18rem 0.4rem 0.12rem;
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
    pointer-events: none;
  }

  .card__tag--photo {
    background: rgb(250 250 250 / 0.94);
    color: var(--c-red-deep);
    font-weight: 700;
  }

  .card__tag--art {
    border: 1px dashed var(--line-strong);
    color: var(--c-white);
  }

  /* Touch flip affordance – on the recess's bottom-right corner (cell bottom, in card units). */
  .card__flip {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(var(--pad) + var(--plate) + var(--plate-gap) + var(--cell) - 2.75rem);
    inset-inline-end: var(--pad);
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--c-red);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;

    &[hidden] {
      display: none;
    }

    &:focus-visible {
      outline: 2px solid var(--c-white);
      outline-offset: -4px;
      border-radius: 50%;
    }

    /* Fine pointers flip on hover/focus – the button is only for touch. */
    @media (hover: hover) and (pointer: fine) {
      display: none;
    }
  }

  .card__flip-icon {
    display: grid;
    place-items: center;
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: 50%;
    background: var(--c-white);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0.2rem 0.6rem rgb(0 0 0 / 0.35);
    transition: rotate var(--dur) var(--ease-out);
  }

  .card__flip[aria-pressed='true'] .card__flip-icon {
    rotate: 180deg;
  }

  /* Tapped flip (touch). Leaving for the detail page snaps back to the front. */
  :global(:root:not([data-leaving])) .card[data-flipped] {
    .card__face--front:has(+ .card__face--back:not([data-back-pending])) {
      transform: rotateY(-180deg);
    }

    .card__face--back:not([data-back-pending]) {
      transform: rotateY(0deg);
    }
  }

  /* Name plate under the door. */
  .card__body {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    margin-block-start: 4cqi;
  }

  .card__name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .card__first {
    display: block;
    margin-block-end: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .card__last {
    display: inline-block;
    max-inline-size: 100%;
    font-size: clamp(1.05rem, 11cqi, 2rem);
    font-stretch: 75%;
    overflow-wrap: anywhere;
  }

  .card__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.35;
    color: var(--fg-muted);
  }

  .card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* White on red only; gold is a decorative border, never text. */
  .badge {
    padding: 0.2rem 0.45rem 0.15rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--c-white);
  }

  .badge--signed {
    border-color: transparent;
    background: var(--c-white);
    color: var(--c-red-deep);
    font-weight: 700;
  }

  .badge--match-worn {
    border-color: var(--c-white);
    font-weight: 700;
  }

  .badge--match-issued {
    border-color: var(--c-gold);
  }

  .badge--unconfirmed {
    border-style: dashed;
  }

  /* Placeholders: outline number, hatched recess – still a link. */
  .card[data-draft='1'] {
    .card__no {
      color: transparent;
      -webkit-text-stroke: 1px var(--line-strong);
    }

    .card__cell {
      background:
        repeating-linear-gradient(118deg, transparent 0 14px, rgb(0 0 0 / 0.08) 14px 15px),
        linear-gradient(rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.1));
    }
  }

  /* Hover (fine pointers) / keyboard focus: the locker lights up, the shirt sways on its peg
     and photo cards turn to the back. */
  @media (hover: hover) and (pointer: fine) {
    :global(:root:not([data-leaving])) .card__link:hover {
      background: rgb(255 255 255 / 0.06);

      .card__no {
        color: var(--c-white);
      }

      @media (prefers-reduced-motion: no-preference) {
        .card__hang {
          animation: kolekcja-sway 1.6s var(--ease-out) both;
        }
      }

      .card__face--front:has(+ .card__face--back:not([data-back-pending])) {
        transform: rotateY(-180deg);
      }

      .card__face--back:not([data-back-pending]) {
        transform: rotateY(0deg);
      }

      .card__face--back :global(.sig) {
        opacity: 1;
        stroke-dashoffset: 0;

        /* The signature draws itself only when motion is welcome (instant otherwise). */
        @media (prefers-reduced-motion: no-preference) {
          transition:
            stroke-dashoffset 1.2s var(--ease-in-out) 0.5s,
            opacity 0s 0.5s;
        }
      }
    }
  }

  :global(:root:not([data-leaving])) .card__link:focus-visible {
    background: rgb(255 255 255 / 0.06);

    .card__no {
      color: var(--c-white);
    }

    @media (prefers-reduced-motion: no-preference) {
      .card__hang {
        animation: kolekcja-sway 1.6s var(--ease-out) both;
      }
    }

    .card__face--front:has(+ .card__face--back:not([data-back-pending])) {
      transform: rotateY(-180deg);
    }

    .card__face--back:not([data-back-pending]) {
      transform: rotateY(0deg);
    }
  }

  /* Leaving for a detail page: snap back to the front, upright, so the morph starts from it.
     (Outranks every card transition above – they are all single-class, zero-specificity scoped.) */
  :global(:root[data-leaving]) .card__link * {
    transition: none;
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__link,
    .card__face,
    .card__face--back :global(.sig),
    .card__no,
    .card__flip-icon {
      transition-duration: 0.01ms;
      transition-delay: 0s;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhands on purpose: the minifier folds a full set into the `animation` shorthand,
         where `view()` is invalid (timeline is reset-only there) and Chrome drops the rule. */
      .card {
        animation-name: card-rise;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view();
        animation-range: entry 0% entry 65%;
      }
    }
  }

  @keyframes card-rise {
    from {
      opacity: 0;
      translate: 0 2.5rem;
      scale: 0.96;
    }
  }

  /* Damped pendulum from the peg. */
  @keyframes kolekcja-sway {
    0% {
      rotate: 0deg;
    }
    20% {
      rotate: 3.5deg;
    }
    45% {
      rotate: -2.2deg;
    }
    68% {
      rotate: 1.1deg;
    }
    86% {
      rotate: -0.4deg;
    }
    100% {
      rotate: 0deg;
    }
  }
</style>
