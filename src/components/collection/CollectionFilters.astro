---
/**
 * Collection filters – „Szybkie filtry” (Airbnb / Google Shopping style).
 * The real runtime (collection.ts) drives filtering, URL sync, counts and the live region:
 *  - `.filters-bar`   [data-bar] sticky: search (collapses to an icon on small phones), live count,
 *               sort as an icon menu (the one and only `sort` select), „Wszystkie filtry” + badge
 *  - `.filters-rail`  the white sash with ONE scrolling row of quick chips – aria-pressed buttons
 *               that toggle the real checkboxes in the dialog (see quick-filters.ts)
 *  - `<dialog>` [data-sheet] every group with live counts + „Pokaż N koszulek” [data-apply]:
 *               bottom sheet on phones, centred modal from 48rem. collection.ts already defers
 *               the grid update while it is open and applies it on close.
 * All inputs belong to one <form> via the `form` attribute (same names / values as the page).
 */
import type { Facet } from './model';
import type { CollectionStrings } from './strings';
import { plural } from './search';

interface Props {
  strings: CollectionStrings['filters'];
  quick: CollectionStrings['quick'];
  facets: Facet[];
  total: number;
  signedCount: number;
  describedCount: number;
  forms: CollectionStrings['client']['forms'];
}

const { strings, quick, facets, total, signedCount, describedCount, forms } = Astro.props;
const FORM = 'collection-filters';
const sorts = Object.entries(strings.sortOptions) as [keyof typeof strings.sortOptions, string][];

const values = (group: Facet['group']): Set<string> =>
  new Set(facets.find((facet) => facet.group === group)?.options.map((option) => option.value) ?? []);
const eras = values('era');
const kinds = values('kind');
const colors = facets.find((facet) => facet.group === 'color')?.options ?? [];

interface Quick {
  label: string;
  star?: boolean;
  targets: [string, string][];
  swatch?: string;
}

/** Quick-chip groups (a star separates them on the rail); options missing from the data are dropped. */
const groups: Quick[][] = [
  [
    { label: quick.signed, star: true, targets: [['signed', '1']] },
    { label: quick.described, targets: [['described', '1']] },
  ],
  quick.decades
    .map(({ label, eras: list }) => ({
      label,
      targets: list.filter((era) => eras.has(era)).map((era): [string, string] => ['era', era]),
    }))
    .filter((chip) => chip.targets.length > 0),
  quick.kinds.filter(({ kind }) => kinds.has(kind)).map(({ label, kind }) => ({ label, targets: [['kind', kind]] })),
  colors.map((option) => ({ label: option.label, targets: [['color', option.value]], swatch: option.swatch })),
].filter((group) => group.length > 0);
---

<div class="filters-bar" data-bar>
  <search class="filters-bar__inner" aria-label={strings.region}>
    <form id={FORM} class="filters-bar__form" autocomplete="off" data-form>
      <label class="filters-field">
        <span class="visually-hidden">{strings.search}</span>
        <svg class="filters-field__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="10.5" cy="10.5" r="6.5"></circle>
          <path d="M15.5 15.5 21 21"></path>
        </svg>
        <input
          class="filters-field__input"
          type="search"
          name="q"
          placeholder={strings.searchPlaceholder}
          enterkeyhint="search"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
        />
      </label>

      <p class="filters-count" aria-hidden="true">
        <b data-count-shown>{total}</b> <span data-count-label>{plural(total, forms)}</span>
      </p>

      <label class="filters-sort" data-c-sort>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 4v16M3.5 16.5 7 20l3.5-3.5M17 20V4M13.5 7.5 17 4l3.5 3.5"></path>
        </svg>
        <span class="filters-sort__value" aria-hidden="true" data-c-sort-value>{sorts[0]?.[1]}</span>
        <span class="filters-sort__dot" aria-hidden="true"></span>
        <select name="sort" form={FORM} aria-label={strings.sort}>
          {sorts.map(([value, label], i) => <option value={value} selected={i === 0}>{label}</option>)}
        </select>
      </label>

      <button type="button" class="filters-all" aria-haspopup="dialog" aria-controls="collection-sheet" data-c-open>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 7h11M18 7h3M3 17h4M11 17h10"></path>
          <circle cx="16" cy="7" r="2.2"></circle>
          <circle cx="9" cy="17" r="2.2"></circle>
        </svg>
        <span class="filters-all__long">{quick.all}</span>
        <span class="filters-all__short" aria-hidden="true">{quick.allShort}</span>
        <span class="filters-all__badge" data-active-count hidden>
          <span data-active-num>0</span><span class="visually-hidden"> {strings.activeCount}</span>
        </span>
      </button>
    </form>
  </search>
</div>

<!-- The quick row on the white sash: a ticker of the most-used filters. -->
<div class="filters-rail" data-c-rail>
  <p class="filters-rail__tag" id="filters-rail-label">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polygon points="12,1.5 14.9,8.6 22.5,9.2 16.7,14.2 18.5,21.6 12,17.6 5.5,21.6 7.3,14.2 1.5,9.2 9.1,8.6"></polygon>
    </svg>
    <span class="filters-rail__tag-long">{quick.rail}</span>
    <span class="visually-hidden filters-rail__tag-sr">{quick.railShort}</span>
  </p>
  <!-- Outside the scroller: appearing / hiding never shifts the chips under the pointer. -->
  <div class="filters-rail__clear">
    <button type="button" class="filters-chip filters-chip--clear" data-reset hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      <span class="filters-chip--clear__label">{quick.clear}</span>
    </button>
  </div>
  <div class="filters-rail__track">
    <button type="button" class="filters-rail__arrow filters-rail__arrow--prev" tabindex="-1" data-c-prev>
      <svg viewBox="0 0 24 24" focusable="false"><path d="m15 5-7 7 7 7"></path></svg>
      <span class="visually-hidden">{quick.prev}</span>
    </button>
    <div class="filters-rail__scroller" role="group" aria-labelledby="filters-rail-label" data-c-scroller>
      {
        groups.map((group, g) => (
          <>
            {g > 0 && <span class="filters-sep" aria-hidden="true">★</span>}
            {group.map((chip) =>
              chip.swatch ? (
                <button
                  type="button"
                  class="filters-chip filters-chip--dot"
                  aria-pressed="false"
                  title={`${quick.colorPrefix} ${chip.label}`}
                  data-c-quick={JSON.stringify(chip.targets)}
                >
                  <span class="filters-chip__swatch" style={`--sw:${chip.swatch}`} aria-hidden="true" />
                  <span class="filters-chip__label">
                    <span class="visually-hidden">{quick.colorPrefix} </span>
                    {chip.label}
                  </span>
                </button>
              ) : (
                <button type="button" class="filters-chip" aria-pressed="false" data-c-quick={JSON.stringify(chip.targets)}>
                  {chip.star && <span aria-hidden="true">★</span>}
                  {chip.label}
                  <svg class="filters-chip__x" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M7 7l10 10M17 7 7 17"></path>
                  </svg>
                </button>
              ),
            )}
          </>
        ))
      }
    </div>
    <button type="button" class="filters-rail__arrow filters-rail__arrow--next" tabindex="-1" data-c-next>
      <svg viewBox="0 0 24 24" focusable="false"><path d="m9 5 7 7-7 7"></path></svg>
      <span class="visually-hidden">{quick.next}</span>
    </button>
  </div>
</div>

<dialog id="collection-sheet" class="filters-sheet" aria-labelledby="filters-sheet-title" data-sheet closedby="any">
  <div class="filters-sheet__head">
    <h2 id="filters-sheet-title" class="filters-sheet__title">{quick.all}</h2>
    <button type="button" class="filters-btn filters-sheet__close" data-sheet-close aria-label={strings.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg>
    </button>
  </div>
  <div class="filters-sheet__body">
    {
      facets.map((facet) => (
        <fieldset class="group">
          <legend class="group__legend">{facet.legend}</legend>
          <div class="chips">
            {facet.options.map((option) => (
              <label class="chip">
                <input type="checkbox" name={facet.group} value={option.value} form={FORM} />
                {option.swatch && <span class="chip__swatch" style={`--sw:${option.swatch}`} />}
                <span class="chip__label">{option.label}</span>
                <span class="chip__count" data-facet-count={`${facet.group}:${option.value}`}>
                  {option.count}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
    <fieldset class="group">
      <legend class="group__legend">{strings.groups.options}</legend>
      <div class="chips">
        <label class="switch">
          <input type="checkbox" role="switch" name="signed" value="1" form={FORM} />
          <span><span aria-hidden="true">★ </span>{strings.signed}</span>
          <span class="chip__count" data-facet-count="signed">{signedCount}</span>
        </label>
        <label class="switch">
          <input type="checkbox" role="switch" name="described" value="1" form={FORM} />
          <span>{strings.described}</span>
          <span class="chip__count" data-facet-count="described">{describedCount}</span>
        </label>
      </div>
    </fieldset>
  </div>
  <div class="filters-sheet__foot">
    <button type="button" class="filters-btn" data-reset>{strings.reset}</button>
    <button type="button" class="filters-btn filters-btn--primary" data-sheet-close data-apply>{quick.all}</button>
  </div>
</dialog>

<style>
  /* Without JS the grid lists everything – hide controls that could not work. */
  :global(:root:not([data-js])) :is(.filters-bar, .filters-rail) {
    display: none;
  }

  /* No page scroll behind the open modal / sheet. */
  :global(html:has(.filters-sheet[open])) {
    overflow: hidden;
  }

  /* ——— Sticky bar: search · count · sort · „Wszystkie filtry” ——— */
  .filters-bar {
    position: sticky;
    inset-block-start: var(--hdr-offset, 0px);
    z-index: 30;
    padding: 0.5rem var(--gutter);
    background: var(--c-red-deep);
    border-block: 1px solid var(--line);
    view-transition-name: collection-bar;

    @media (prefers-reduced-motion: no-preference) {
      transition: inset-block-start 420ms var(--ease-out);
    }
  }

  .filters-bar__form {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;

    @media (min-width: 48rem) {
      gap: 0.75rem;
    }
  }

  .filters-field {
    position: relative;
    flex: 1 1 0;
    min-inline-size: 0;

    @media (prefers-reduced-motion: no-preference) {
      transition: flex-basis var(--dur-fast) var(--ease-out), flex-grow var(--dur-fast) var(--ease-out);
    }

    @media (min-width: 48rem) {
      flex: 0 1 24rem;
    }
  }

  .filters-field__icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.8rem;
    inline-size: 1.05rem;
    translate: 0 -50%;
    fill: none;
    stroke: var(--c-white);
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .filters-field__input {
    inline-size: 100%;
    block-size: 2.75rem;
    padding: 0 0.9rem 0 2.5rem;
    border: 1.5px solid var(--line-control);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.16);
    color: var(--c-white);
    font: 500 1rem/1 var(--font-body);
    transition: border-color var(--dur-fast), background-color var(--dur-fast);

    &::placeholder {
      color: var(--fg-muted);
      opacity: 1;
    }

    &:hover {
      border-color: var(--c-white);
    }

    &:focus-visible {
      outline: 2px solid var(--c-white);
      outline-offset: 2px;
      border-color: var(--c-white);
      background: rgb(0 0 0 / 0.24);
    }
  }

  .filters-count {
    display: none;
    flex: 1 1 auto;
    min-inline-size: 0;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;

    b {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 900;
      letter-spacing: 0;
    }
  }

  /* Small phones: an empty, unfocused search folds into a round icon; the count takes its place. */
  @media (max-width: 29.99rem) {
    .filters-field:not(:focus-within):has(.filters-field__input:placeholder-shown) {
      flex: 0 0 2.75rem;

      .filters-field__input {
        padding: 0;
        cursor: pointer;

        &::placeholder {
          color: transparent;
        }
      }
    }

    .filters-bar__form:has(.filters-field:not(:focus-within) .filters-field__input:placeholder-shown) .filters-count {
      display: block;
    }

    /* While typing, the search gets the room: sort steps aside visually but stays in the tab order. */
    .filters-bar__form:has(.filters-field:focus-within) .filters-sort {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      min-inline-size: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (min-width: 48rem) {
    .filters-count {
      display: block;
    }
  }

  /* Sort: an icon button that is really the native <select> (full menu on every platform). */
  .filters-sort {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1.5px solid var(--line-control);
    border-radius: 999px;
    color: var(--c-white);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color var(--dur-fast);

    &:hover {
      border-color: var(--c-white);
    }

    &:has(:focus-visible) {
      outline: 2px solid var(--c-white);
      outline-offset: 2px;
    }

    svg {
      inline-size: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    select {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;
      margin: 0;
      opacity: 0;
      font-size: 1rem;
      cursor: pointer;
      appearance: none;

      option {
        background: #6a0717;
        color: var(--c-white);
      }
    }

    @media (min-width: 64rem) {
      padding-inline: 0.9rem;
    }
  }

  .filters-sort__value {
    display: none;

    @media (min-width: 64rem) {
      display: inline;
    }
  }

  /* A non-default order is a (small) active state too. */
  .filters-sort__dot {
    position: absolute;
    inset-block-start: 0.3rem;
    inset-inline-end: 0.3rem;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--c-white);
    box-shadow: 0 0 0 2px var(--c-red-deep);
    display: none;
  }

  .filters-sort[data-sorted] .filters-sort__dot {
    display: block;
  }

  .filters-all,
  .filters-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-block-size: 2.75rem;
    padding: 0 0.95rem;
    border: 1.5px solid var(--line-control);
    border-radius: 999px;
    background: transparent;
    color: var(--c-white);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast), border-color var(--dur-fast);

    &:hover {
      border-color: var(--c-white);
    }

    &:focus-visible {
      outline: 2px solid var(--c-white);
      outline-offset: 2px;
    }

    svg {
      inline-size: 1.1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
    }
  }

  /* White pill – the bar's primary action. */
  .filters-all,
  .filters-btn--primary {
    border-color: var(--c-white);
    background: var(--c-white);
    color: var(--c-red-deep);

    &:hover {
      background: rgb(250 250 250 / 0.88);
    }
  }

  .filters-all {
    margin-inline-start: auto;
  }

  /* „Filtry” below 24rem, „Wszystkie filtry” above; the accessible name is always the long one. */
  .filters-all__long {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;

    @media (min-width: 24rem) {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  /* 320px phones: icon + badge only, so the live count keeps its room. */
  .filters-all__short {
    @media (max-width: 22.49rem) {
      display: none;
    }

    @media (min-width: 24rem) {
      display: none;
    }
  }

  .filters-all__badge {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.3rem;
    block-size: 1.3rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    background: var(--c-red-deep);
    color: var(--c-white);
    letter-spacing: 0;

    &[hidden] {
      display: none;
    }
  }

  /* ——— Rail: the white sash, chips riding on it like a ticker ——— */
  .filters-rail {
    --rail-ink: var(--c-red-deep);

    position: relative;
    display: flex;
    align-items: stretch;
    margin-block: 0.9rem clamp(1.5rem, 4vw, 2.5rem);
    border-block: 3px solid var(--c-white);
    background: var(--c-white);
    color: var(--rail-ink);
    box-shadow:
      0 0.35rem 0 rgb(0 0 0 / 0.14),
      0 1.2rem 2rem -0.8rem rgb(0 0 0 / 0.35);
  }

  .filters-rail__tag {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0 0.75rem 0 var(--gutter);
    background: var(--c-red);
    color: var(--c-white);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    /* Ticker flag: the red tab ends in a notch. */
    clip-path: polygon(0 0, 100% 0, calc(100% - 0.55rem) 50%, 100% 100%, 0 100%);
    padding-inline-end: 1.1rem;

    svg {
      inline-size: 0.95rem;
      fill: currentColor;
    }
  }

  /* Phones: star only (the group keeps its full name for screen readers). */
  .filters-rail__tag-long {
    display: none;

    @media (min-width: 40rem) {
      display: inline;
    }
  }

  .filters-rail__tag-sr {
    @media (min-width: 40rem) {
      display: none;
    }
  }

  .filters-rail__track {
    position: relative;
    flex: 1;
    min-inline-size: 0;
    display: flex;
  }

  .filters-rail__scroller {
    --fade-start: 0px;
    --fade-end: 0px;

    position: relative; /* offsetParent for the chips (quick-filters.ts scroll-into-view maths) */
    flex: 1;
    min-inline-size: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem var(--gutter) 0.5rem 0.6rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 0.6rem;
    scrollbar-width: none;
    /* Red pinstripes top and bottom – the sash with its red edges. */
    background: linear-gradient(var(--c-red) 0 2px, transparent 2px calc(100% - 2px), var(--c-red) calc(100% - 2px));
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 var(--fade-start),
      #000 calc(100% - var(--fade-end)),
      transparent 100%
    );

    &::-webkit-scrollbar {
      display: none;
    }

    > * {
      scroll-snap-align: start;
    }

    &[data-more-start] {
      --fade-start: 2rem;
    }

    &[data-more-end] {
      --fade-end: 3rem;
    }

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth;
    }
  }

  .filters-sep {
    flex: none;
    padding-inline: 0.15rem;
    color: var(--c-red);
    font-size: 0.7rem;
    line-height: 1;
  }

  .filters-chip {
    position: relative;
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-block-size: 2.25rem;
    padding: 0 0.85rem;
    border: 1.5px solid var(--c-red);
    border-radius: 999px;
    background: var(--c-white);
    color: var(--rail-ink);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    font-stretch: 90%;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);

    &:hover {
      background: #fbe7ea;
    }

    &:focus-visible {
      outline: 2px solid var(--c-ink);
      outline-offset: 2px;
    }

    /* Zero results with the other filters kept: still usable, clearly secondary. */
    &[data-empty]:not([aria-pressed='true']) {
      border-style: dashed;
      color: rgb(142 10 32 / 0.85);
    }

    &[aria-pressed='true'] {
      background: var(--c-red);
      border-color: var(--c-red);
      color: var(--c-white);

      &:hover {
        background: var(--c-red-deep);
      }
    }
  }

  .filters-chip__x {
    display: none;
    inline-size: 0.85rem;
    margin-inline-end: -0.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;

    [aria-pressed='true'] > & {
      display: block;
    }
  }

  .filters-rail__clear {
    flex: none;
    display: flex;
    align-items: center;
    background: linear-gradient(var(--c-red) 0 2px, transparent 2px calc(100% - 2px), var(--c-red) calc(100% - 2px));

    &:has([data-reset]:not([hidden])) {
