---
/**
 * The locker bank: list landmark, empty state, polite live region, the outline-shirt
 * sprite the placeholder lockers <use>, plus the (global) view-transition choreography
 * used while filtering.
 */
import { BODY, CHEST_STAR, CUFFS, HEM, NECK_FRONT, SEAMS, VIEWBOX } from '../shirt/geometry';
import type { CollectionStrings } from './strings';

interface Props {
  strings: CollectionStrings['results'];
}

const { strings } = Astro.props;
---

<section class="results" id="kolekcja-lista" aria-labelledby="results-title" data-results>
  <!-- tabindex=-1: focus target after „Wyczyść filtry” in the empty state. -->
  <h2 id="results-title" class="visually-hidden" tabindex="-1">{strings.heading}</h2>

  <!-- Chalk-outline placeholder shirt, drawn once and <use>d by every draft locker (colour = currentColor). -->
  <svg class="outline-sprite" aria-hidden="true" focusable="false">
    <symbol id="shirt-sym-outline" viewBox={VIEWBOX}>
      <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round">
        <path d={BODY} stroke-width="2" vector-effect="non-scaling-stroke"></path>
        <path d={NECK_FRONT} stroke-width="2" vector-effect="non-scaling-stroke"></path>
        <g stroke-width="1" opacity="0.6">
          <path d={SEAMS} vector-effect="non-scaling-stroke"></path>
          <path d={CUFFS} vector-effect="non-scaling-stroke"></path>
          <path d={HEM} vector-effect="non-scaling-stroke"></path>
        </g>
        <polygon points={CHEST_STAR} stroke-width="2" vector-effect="non-scaling-stroke"></polygon>
      </g>
    </symbol>
  </svg>
  <ul class="grid" data-grid>
    <slot />
  </ul>

  <div class="empty" data-empty-state hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <polygon points="12,1.5 14.9,8.6 22.5,9.2 16.7,14.2 18.5,21.6 12,17.6 5.5,21.6 7.3,14.2 1.5,9.2 9.1,8.6"></polygon>
    </svg>
    <p class="empty__title">{strings.emptyTitle}</p>
    <p class="empty__text">{strings.emptyText}</p>
    <button type="button" class="empty__reset" data-reset>{strings.emptyReset}</button>
  </div>

  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-live></p>
</section>

<style>
  .results {
    padding: 0 var(--gutter) clamp(3rem, 8vw, 6rem);
  }

  /* Not display:none – some engines then drop what a <use> references. */
  .outline-sprite {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
  }

  /* The bank of lockers: no gaps, hairline seams (each locker draws its right/bottom edge). */
  .grid {
    --cols: 2;
    --body-h: 7.5rem;

    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);

    /* Nothing to frame when every locker is filtered out. */
    &:not(:has(> :not([hidden]))) {
      border: 0;
    }

    @media (min-width: 40rem) {
      --cols: 3;
    }

    @media (min-width: 64rem) {
      --cols: 4;
      --body-h: 6rem;
    }

    @media (min-width: 96rem) {
      --cols: 5;
    }
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: 3rem 1rem 4rem;
    text-align: center;

    &[hidden] {
      display: none;
    }

    svg {
      inline-size: 3.5rem;
      margin-block-end: 0.5rem;
      fill: none;
      stroke: var(--c-white);
      stroke-width: 0.9;
    }
  }

  .empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .empty__text {
    margin: 0;
  }

  .empty__reset {
    margin-block-start: 1rem;
    min-block-size: 2.75rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-red-deep);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;

    &:hover {
      background: rgb(250 250 250 / 0.88);
    }

    &:focus-visible {
      outline: 2px solid var(--c-white);
      outline-offset: 3px;
    }
  }
</style>

<style is:global>
  /* Restoring a filtered view from the URL: hide everything that shows unfiltered numbers –
     grid, filter bar (count, chips) and the masthead count – for the few ms before the runtime
     applies the query (no flash, no CLS). Failsafe reveal if the runtime never removes the flag. */
  :root[data-restore] :is([data-results], [data-bar], [data-c-rail], [data-count-shown], [data-count-label]) {
    visibility: hidden;
    animation: restore-failsafe 0s 1.5s forwards;
  }

  @keyframes restore-failsafe {
    to {
      visibility: visible;
    }
  }

  /* ——— Filter choreography (same-document view transition, type „collection-filter”) ———
     Cards and shirt visuals get names only for the duration of the transition (see collection.ts);
     the root crossfade is kept short so only the grid seems to move. */
  :root:active-view-transition-type(collection-filter)::view-transition-group(*.collection-card),
  :root:active-view-transition-type(collection-filter)::view-transition-group(*.collection-shirt) {
    animation-duration: 560ms;
    animation-timing-function: cubic-bezier(0.2, 0.85, 0.25, 1);
  }

  :root:active-view-transition-type(collection-filter)::view-transition-old(*.collection-card):only-child,
  :root:active-view-transition-type(collection-filter)::view-transition-old(*.collection-shirt):only-child {
    animation: 240ms cubic-bezier(0.4, 0, 1, 1) both collection-card-out;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-new(*.collection-card):only-child,
  :root:active-view-transition-type(collection-filter)::view-transition-new(*.collection-shirt):only-child {
    animation: 420ms cubic-bezier(0.16, 1, 0.3, 1) 140ms both collection-card-in;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-old(root),
  :root:active-view-transition-type(collection-filter)::view-transition-new(root) {
    animation-duration: 180ms;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-image-pair(collection-count) {
    overflow: clip;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-old(collection-count),
  :root:active-view-transition-type(collection-filter)::view-transition-new(collection-count) {
    inline-size: auto;
    block-size: 100%;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-old(collection-count) {
    animation: 260ms cubic-bezier(0.4, 0, 1, 1) both collection-count-out;
  }

  :root:active-view-transition-type(collection-filter)::view-transition-new(collection-count) {
    animation: 360ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both collection-count-in;
  }

  @keyframes collection-card-out {
    to {
      opacity: 0;
      scale: 0.88;
    }
  }

  @keyframes collection-card-in {
    from {
      opacity: 0;
      scale: 0.9;
      translate: 0 1.25rem;
    }
  }

  @keyframes collection-count-out {
    to {
      opacity: 0;
      translate: 0 -40%;
    }
  }

  @keyframes collection-count-in {
    from {
      opacity: 0;
      translate: 0 40%;
    }
  }
</style>
