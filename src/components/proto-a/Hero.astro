---
import { Picture } from 'astro:assets';
import wallPhoto from '../../assets/sciana-kolekcji.webp';
import { COLLECTION_SIZE } from '../../data/collection';
import { hotspots } from './hotspots';

const fmt = (n: number) => `${n.toFixed(3)}%`;
const nameOf = (player: string) => (player === '?' ? 'nazwisko nieczytelne' : player);
---

<div class="pa">
  <section class="scene" data-scene aria-label="Kolekcja – interaktywna ściana koszulek">
    <div class="pin" data-pin>
      <a class="back" href="/">← prototypy</a>

      <header class="title" data-fade>
        <h1>Coś więcej niż <span class="hl">pasja</span></h1>
        <p class="kicker">Meczowe koszulki Wisły Kraków · kolekcja @cos_wiecej_niz_pasja</p>
      </header>

      <div class="stage" data-stage>
        <div class="wall" data-wall>
          <Picture
            src={wallPhoto}
            alt="Ściana z 86 koszulkami Wisły Kraków powieszonymi w pięciu rzędach na ogrodzeniu; w środku dolnego rzędu siedzi kolekcjoner."
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[720, 1080, 1440]}
            sizes="(max-aspect-ratio: 5/4) 1100px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            pictureAttributes={{ class: 'photo' }}
          />
          <div class="spots" role="group" aria-label="Koszulki w kolekcji">
            {
              hotspots.map((h) => (
                <button
                  type="button"
                  class="pa-spot"
                  data-row={h.row}
                  data-edge={h.edge}
                  data-target={h.target ? '' : undefined}
                  aria-label={`${nameOf(h.player)}, numer ${h.number}`}
                  style={`left:${fmt(h.left)};top:${fmt(h.top)};width:${fmt(h.width)};height:${fmt(h.height)};--d:${h.delay}`}
                >
                  <span class="tag" aria-hidden="true">
                    <span class="tag-no">Nr {h.number}</span>
                    <span class="tag-name">{h.player === '?' ? '—' : h.player}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <script is:inline>
        (() => {
          const s = document.querySelector('[data-stage]');
          if (s) s.scrollLeft = (s.scrollWidth - s.clientWidth) / 2;
        })();
      </script>

      <p class="hint" data-hint data-fade>
        <span aria-hidden="true">←</span> Przesuń, by zobaczyć całą ścianę <span aria-hidden="true">→</span>
      </p>

      <p class="caption" data-fade>
        <strong>{COLLECTION_SIZE}</strong>
        <span>koszulek w kolekcji</span>
        <span class="caption-help">
          <span class="when-hover">Najedź na koszulkę</span>
          <span class="when-touch">Dotknij koszulkę</span>
        </span>
      </p>

      <div class="vignette" data-vignette aria-hidden="true"></div>
      <p class="handoff" data-handoff aria-hidden="true">Ostatni nabytek · #93 <span>↓</span></p>

      <div class="intro" data-intro-ui>
        <p class="counter"><span data-counter aria-hidden="true">00</span><small>koszulek w kolekcji</small></p>
        <button type="button" class="skip" data-skip>Pomiń intro</button>
      </div>
    </div>
  </section>
</div>

<script>
  import { initIntro } from './intro';
  import { initWall } from './wall';
  import { initZoom } from './zoom';

  const root = document.querySelector<HTMLElement>('.pa');
  const q = <T extends HTMLElement>(sel: string) => root?.querySelector<T>(sel) ?? null;

  const scene = q('[data-scene]');
  const pin = q('[data-pin]');
  const stage = q('[data-stage]');
  const wall = q('[data-wall]');
  const target = q('.pa-spot[data-target]');
  const vignette = q('[data-vignette]');
  const handoff = q('[data-handoff]');

  if (root && scene && pin && stage && wall && target && vignette && handoff) {
    initIntro(root);
    initWall(stage, q('[data-hint]'));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      initZoom({
        scene,
        pin,
        stage,
        wall,
        target,
        vignette,
        handoff,
        fading: Array.from(root.querySelectorAll<HTMLElement>('[data-fade]')),
      });
    }
  }
</script>

<style is:global>
  .pa {
    --ratio: 1.7266; /* 1440 / 834 */
    --title-h: 22svh;
    --wall-h: 56svh;
    --wall-w: calc(var(--wall-h) * var(--ratio));
    --ink-a: rgb(5 15 26 / 0.94);
    background: var(--c-ink);

    /* Desktop / landscape: photo covers the screen, no panning needed */
    @media (min-width: 48rem) and (min-aspect-ratio: 5/4) {
      --title-h: 0px;
      --wall-w: max(100vw, calc(100svh * var(--ratio)));
    }

    .scene {
      position: relative;
    }

    .pin {
      position: relative;
      height: 100svh;
      min-height: 26rem;
      overflow: hidden;
      isolation: isolate;
      background: var(--c-ink);
    }

    /* Pin + zoom only when motion is welcome; otherwise a plain static hero */
    @media (prefers-reduced-motion: no-preference) {
      .scene {
        height: 270svh;
      }
      .pin {
        position: sticky;
        top: 0;
      }
    }

    /* ---------- Stage / wall ---------- */
    .stage {
      position: absolute;
      inset: 0;
      padding-block: var(--title-h) 7svh;
      display: grid;
      grid-template-columns: var(--wall-w);
      align-items: center;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      @media (min-width: 48rem) and (min-aspect-ratio: 5/4) {
        padding-block: 0;
        align-items: start;
      }
    }

    .pin[data-zoomed] .stage {
      overflow-x: hidden;
      pointer-events: none;
    }

    .wall {
      position: relative;
      width: var(--wall-w);
      aspect-ratio: 1440 / 834;
      scroll-snap-align: center;
      transform-origin: 0 0;
      background: var(--c-ink);
    }

    .photo,
    .photo img {
      display: block;
      width: 100%;
      height: 100%;
      user-select: none;
      -webkit-user-drag: none;
    }

    .photo img {
      object-fit: cover;
    }

    .spots {
      position: absolute;
      inset: 0;
    }

    /* ---------- Hotspots ---------- */
    .pa-spot {
      position: absolute;
      appearance: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      font: inherit;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;

      /* dimming layer: ink, invisible by default */
      &::before {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--c-ink);
        opacity: 0;
        transition: opacity 260ms var(--ease-out);
      }

      /* highlight frame */
      &::after {
        content: '';
        position: absolute;
        inset: 1px;
        border: 1px solid var(--c-gold);
        opacity: 0;
        transition: opacity 160ms;
      }

      &:focus-visible {
        outline: none;
      }

      &:is(:hover, :focus-visible, [data-active]) {
        z-index: 3;

        &::after {
          opacity: 1;
        }

        .tag {
          opacity: 1;
          translate: var(--tx, -50%) 0;
        }
      }
    }

    /* the rest of the wall dims while one shirt is highlighted */
    .spots:has(.pa-spot:is(:hover, :focus-visible, [data-active])) .pa-spot:not(:is(:hover, :focus-visible, [data-active]))::before {
      opacity: 0.74;
    }

    /* ---------- Museum label ---------- */
    .tag {
      --tx: -50%;
      position: absolute;
      left: 50%;
      bottom: calc(100% + 0.4rem);
      translate: var(--tx) 0.3rem;
      z-index: 2;
      display: grid;
      gap: 0.1rem;
      padding: 0.4rem 0.7rem 0.45rem;
      background: var(--ink-a);
      border-top: 1px solid var(--c-gold);
      font-family: var(--font-mono);
      text-align: left;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 180ms,
        translate 260ms var(--ease-out);
    }

    .tag-no {
      font-size: 0.62rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--c-gold);
    }

    .tag-name {
      font-size: var(--fs-sm);
      color: var(--fg);
    }

    .pa-spot[data-row='0'] .tag {
      bottom: auto;
      top: calc(100% + 0.4rem);
    }

    .pa-spot[data-edge='l'] .tag {
      --tx: 0%;
      left: 0;
    }

    .pa-spot[data-edge='r'] .tag {
      --tx: -100%;
      left: auto;
      right: 0;
      translate: 0 0.3rem;
    }

    .pa-spot[data-edge='r']:is(:hover, :focus-visible, [data-active]) .tag {
      translate: 0 0;
    }

    /* ---------- Title ---------- */
    .title {
      position: absolute;
      inset: 0 0 auto;
      z-index: 6;
      padding: clamp(2.6rem, 7svh, 3.4rem) var(--gutter) 1.5rem;
      pointer-events: none;

      @media (min-width: 48rem) and (min-aspect-ratio: 5/4) {
        padding-block: 1.1rem 2.5rem;
        background: linear-gradient(to bottom, rgb(5 15 26 / 0.85), transparent);
      }
    }

    h1 {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 800;
      font-stretch: 75%;
      font-size: clamp(2.1rem, 10.5vw, 3.4rem);
      line-height: 0.92;
      text-transform: uppercase;
      text-wrap: balance;

      @media (min-width: 48rem) {
        font-size: clamp(2.4rem, 5vw, 4.4rem);
      }

      .hl {
        color: var(--c-red-bright);
      }
    }

    .kicker {
      margin: 0.55rem 0 0;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--c-gold);
    }

    .back {
      position: absolute;
      top: 0.9rem;
      right: var(--gutter);
      z-index: 12;
      padding: 0.25rem 0.1rem;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--fg-muted);

      &:hover {
        color: var(--fg);
      }
    }

    /* ---------- Captions / hint ---------- */
    .caption {
      position: absolute;
      left: var(--gutter);
      bottom: max(1rem, 3svh);
      z-index: 6;
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.6rem;
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--fg-muted);
      pointer-events: none;

      strong {
        font-size: var(--fs-lg);
        letter-spacing: 0;
        color: var(--c-gold);
      }

      .when-touch {
        display: inline;
      }
      .when-hover {
        display: none;
      }

      @media (hover: hover) {
        .when-touch {
          display: none;
        }
        .when-hover {
          display: inline;
        }
      }
    }

    .caption-help {
      color: var(--fg);
      opacity: 0.7;
    }

    .hint {
      position: absolute;
      left: 50%;
      bottom: max(3.6rem, 9svh);
      translate: -50% 0;
      z-index: 6;
      margin: 0;
      padding: 0.45rem 0.9rem;
      display: flex;
      gap: 0.6rem;
      align-items: center;
      white-space: nowrap;
      border: 1px solid var(--line);
      border-radius: 99px;
      background: rgb(5 15 26 / 0.72);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.06em;
      color: var(--fg);
      pointer-events: none;
      animation: pa-hint-out 500ms 7s both;
      transition: opacity 400ms;

      &[data-seen] {
        opacity: 0 !important;
      }

      span {
        color: var(--c-gold);
        animation: pa-nudge 1.4s ease-in-out infinite;
      }

      @media (min-width: 48rem) and (min-aspect-ratio: 5/4) {
        display: none;
      }
    }

    /* ---------- Zoom handoff ---------- */
    .vignette {
      position: absolute;
      inset: 0;
      z-index: 4;
      opacity: 0;
      pointer-events: none;
      background: radial-gradient(ellipse 42% 46% at 50% 46%, transparent 30%, var(--c-ink) 100%);
    }

    .handoff {
      position: absolute;
      inset: auto 0 clamp(1.5rem, 7svh, 4rem);
      z-index: 7;
      margin: 0;
      opacity: 0;
      text-align: center;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--c-gold);
      pointer-events: none;

      span {
        display: block;
        margin-top: 0.3rem;
        font-size: var(--fs-lg);
        animation: pa-bob 1.6s ease-in-out infinite;
      }
    }

    /* ---------- Intro (first load only) ---------- */
    .intro {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .hint {
        animation: none;
      }
    }
  }

  /* Intro states – keyed on the flag set by the inline <head> script. */
  html[data-intro='on'] {
    overflow: hidden;

    .pa {
      .intro {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: grid;
        place-content: center;
        text-align: center;
        pointer-events: none;
        animation: pa-fade-out 280ms 1500ms both;
      }

      .counter {
        margin: 0;
        font-family: var(--font-mono);
        color: var(--fg);

        span {
          display: block;
          font-size: clamp(5rem, 26vw, 12rem);
          font-weight: 700;
          line-height: 1;
          font-variant-numeric: tabular-nums;
        }

        small {
          display: block;
          margin-top: 0.4rem;
          font-size: var(--fs-xs);
          letter-spacing: 0.2em;
          text-transform: uppercase;
          color: var(--c-gold);
        }
      }

      .skip {
        position: absolute;
        right: var(--gutter);
        bottom: max(1rem, 3svh);
        pointer-events: auto;
        padding: 0.5rem 0.9rem;
        border: 1px solid var(--line);
        background: transparent;
        color: var(--fg-muted);
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        cursor: pointer;

        &:hover {
          color: var(--fg);
          border-color: var(--c-gold);
        }
      }

      .stage {
        pointer-events: none;
      }

      .pa-spot::before {
        opacity: 1;
        animation: pa-light 340ms var(--ease-out) both;
        animation-delay: calc(var(--d, 0) * 1ms);
      }

      .photo img {
        animation: pa-wake 700ms 850ms var(--ease-out) both;
      }

      h1 {
        animation: pa-headline 850ms 950ms var(--ease-out) both;
      }

      .kicker,
      .caption,
      .hint {
        animation: pa-fade-in 500ms 1500ms both;
      }
    }
  }

  @keyframes pa-light {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes pa-wake {
    from {
      filter: brightness(0.16) saturate(0.5);
    }
    to {
      filter: none;
    }
  }

  @keyframes pa-headline {
    from {
      clip-path: inset(0 100% 0 0);
      font-stretch: 125%;
    }
    to {
      clip-path: inset(0 0 0 0);
      font-stretch: 75%;
    }
  }

  @keyframes pa-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes pa-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes pa-hint-out {
    to {
      opacity: 0;
    }
  }

  @keyframes pa-nudge {
    50% {
      translate: 4px 0;
    }
  }

  @keyframes pa-bob {
    50% {
      translate: 0 5px;
    }
  }
</style>
