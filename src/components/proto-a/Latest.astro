---
import { featured } from '../../data/collection';

const shirt = featured[0];
const condition = [shirt.matchWorn ? 'grana' : null, shirt.signed ? 'z autografem' : null].filter(Boolean).join(', ');
const meta = [
  ['Sezon', shirt.season],
  ['Okazja', shirt.occasion ?? '—'],
  ['Stan', condition],
  ['Producent', shirt.maker ?? '—'],
  ['Numer', String(shirt.number)],
] as const;
---

<section class="latest" id="ostatni-nabytek" aria-labelledby="latest-title">
  <div class="latest-inner">
    <p class="eyebrow">Ostatni nabytek · #{shirt.no}</p>
    <h2 id="latest-title">{shirt.player}</h2>
    <p class="numeral" aria-hidden="true">{shirt.number}</p>
    <dl class="meta">
      {
        meta.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="story">{shirt.story.pl}</p>
    {
      shirt.instagram && (
        <a class="more" href={shirt.instagram} target="_blank" rel="noopener noreferrer">
          Zobacz post na Instagramie →
        </a>
      )
    }
  </div>
</section>

<style is:global>
  .latest {
    position: relative;
    overflow: hidden;
    background: var(--c-ink);
    padding: 14svh var(--gutter) 16svh;
    border-top: 1px solid var(--line);

    .latest-inner {
      position: relative;
      max-width: 62rem;
      margin-inline: auto;
      display: grid;
      gap: 1.4rem;
    }

    .eyebrow {
      margin: 0;
      padding-top: 0.8rem;
      width: fit-content;
      border-top: 1px solid var(--c-gold);
      font-family: var(--font-mono);
      font-size: var(--fs-xs);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--c-gold);
    }

    h2 {
      margin: 0;
      font-family: var(--font-display);
      font-weight: 800;
      font-stretch: 75%;
      font-size: var(--fs-xl);
      line-height: 0.95;
      text-transform: uppercase;
    }

    .numeral {
      position: absolute;
      z-index: -1;
      right: -0.05em;
      top: 2rem;
      margin: 0;
      font-family: var(--font-display);
      font-weight: 900;
      font-stretch: 62%;
      font-size: clamp(9rem, 48vw, 26rem);
      line-height: 0.8;
      color: transparent;
      -webkit-text-stroke: 1px rgb(198 16 46 / 0.55);
      user-select: none;
    }

    .meta {
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);

      div {
        padding: 0.8rem 1rem;
        background: rgb(5 15 26 / 0.88);
      }

      dt {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--c-gold);
      }

      dd {
        margin: 0.15rem 0 0;
        font-weight: 600;
      }
    }

    .story {
      margin: 0;
      max-width: 40rem;
      font-size: var(--fs-lg);
      line-height: 1.35;
      text-wrap: pretty;
    }

    .more {
      width: fit-content;
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      letter-spacing: 0.06em;
      color: var(--fg);
      text-decoration-color: var(--c-red);
      text-underline-offset: 0.35em;
    }

    @media (min-width: 60rem) {
      .latest-inner {
        max-width: 70rem;
        padding-right: 28%;
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      @supports (animation-timeline: view()) {
        .latest-inner > :not(.numeral) {
          animation: pa-rise linear both;
          animation-timeline: view();
          animation-range: entry 5% entry 55%;
        }
      }
    }
  }

  @keyframes pa-rise {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }
</style>
