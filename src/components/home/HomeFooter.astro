---
export interface FooterStrings {
  brand: string;
  disclaimer: string;
  nav: string;
  collection: string;
  instagram: string;
  facebook: string;
  newTab: string;
  copyright: string;
}

interface Props {
  strings: FooterStrings;
  instagram: string;
  facebook: string;
}

const { strings, instagram, facebook } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="foot">
  <p class="brand" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <polygon points="12,1.5 14.9,8.6 22.5,9.2 16.7,14.2 18.5,21.6 12,17.6 5.5,21.6 7.3,14.2 1.5,9.2 9.1,8.6"></polygon>
    </svg>
    {strings.brand}
  </p>

  <nav aria-label={strings.nav}>
    <ul role="list">
      <li><a href="/kolekcja/">{strings.collection}</a></li>
      <li>
        <a href={instagram} target="_blank" rel="noopener">
          {strings.instagram}<span class="visually-hidden"> {strings.newTab}</span>
        </a>
      </li>
      <li>
        <a href={facebook} target="_blank" rel="noopener">
          {strings.facebook}<span class="visually-hidden"> {strings.newTab}</span>
        </a>
      </li>
    </ul>
  </nav>

  <p class="disclaimer">{strings.disclaimer}</p>
  <p class="copy">© {year} {strings.copyright}</p>
</footer>

<style>
  .foot {
    display: grid;
    gap: 1.5rem;
    padding: 5rem var(--gutter) 2.5rem;
    background: var(--c-ink);
    color: var(--c-mist);
    font-size: var(--fs-sm);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    font-stretch: 75%;
    text-transform: uppercase;
    color: var(--c-white);

    & svg {
      inline-size: 1.1em;
      fill: var(--c-red);
    }
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-white);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: border-color var(--dur-fast);

    &:hover,
    &:focus-visible {
      border-color: currentColor;
    }
  }

  .disclaimer,
  .copy {
    margin: 0;
    max-inline-size: 60ch;
  }

  .copy {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  @media (min-width: 48rem) {
    .foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .disclaimer,
    .copy {
      grid-column: 1 / -1;
    }
  }
</style>
