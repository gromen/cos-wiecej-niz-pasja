---
/**
 * „Sezony” – the real shirts grouped by season, oldest → newest.
 * Every stop is a composed spread: year block (+ meta) → shirt(s) on a floor shadow → caption card.
 *
 * Base layout (mobile, reduced motion, no scroll-driven animations; JS not required):
 *   a native horizontal scroll-snap strip – one season per card, stacked year → shirt(s) → caption.
 *   All cards share the tallest card's height (year top, shirt centred, caption on the bottom edge).
 *   The season chips only appear once home.ts has wired them up (`data-ready`).
 * ≥ 48rem strip – who gets it: every viewport 48–64rem wide; ≥ 64rem with
 *   `prefers-reduced-motion: reduce`; ≥ 64rem in browsers without scroll-driven animations
 *   (`animation-timeline: view()` + `view-timeline` + `animation-range`), i.e. Safari < 26 and
 *   Firefox < 159 (Chrome/Edge have them since 115; caniuse, 2026):
 *   the same two-column spread as the pinned layout (year + caption left, shirt right), sized to
 *   the viewport height, centred snap with the neighbours peeking in.
 * ≥ 64rem + motion + scroll-driven animations (Chrome/Edge 115+, Safari 26+, Firefox 159+):
 *   the section is pinned and vertical scroll drives the strip sideways (pure CSS, a view-timeline
 *   on the section). Each spread fills the viewport: year (+ card for a single shirt) left,
 *   shirt(s) right, overlapping the year column only at its padding edge. Year type
 *   stretches as it passes, shirts slide/scale in with a slight parallax against the year.
 *
 * The shirt visual carries the shared `view-transition-name`, so clicking morphs
 * into the detail page. The featured cards further down reuse the same names –
 * home.ts moves the name to whichever element was clicked (never two at once).
 * Each shirt is an <article>: the card's link finds its visual via `closest('article')`.
 */
import ShirtFace from '../shirt/ShirtFace.astro';
import { lastName, shirtHref, shirtTransitionName, type ShirtEntry } from '../../lib/shirts';

export interface SeasonsStrings {
  kicker: string;
  hint: string;
  approxPrefix: string;
  number: string;
  open: string;
  navLabel: string;
  /** „Sezon” in the „Sezon 02 / 06” meta line. */
  stopLabel: string;
  /** Accessible names of the prev/next arrow buttons. */
  prev: string;
  next: string;
}

interface Props {
  shirts: ShirtEntry[];
  strings: SeasonsStrings;
  /** id of the heading (rendered by the Flip right before this section). */
  labelledby: string;
}

const { shirts, strings, labelledby } = Astro.props;

interface Stop {
  key: string;
  start: number;
  big: string;
  small: string;
  prefix: string;
  shirts: ShirtEntry[];
}

const bySeason = new Map<string, Stop>();
shirts
  .filter(({ data }) => !data.draft && data.seasonStart !== undefined)
  .forEach((entry) => {
    const { season = '', seasonStart = 0, seasonApprox } = entry.data;
    const key = season || String(seasonStart);
    const stop = bySeason.get(key);
    if (stop) {
      stop.shirts.push(entry);
      return;
    }
    const split = /^(\d{4})\/(\d{2})$/.exec(season);
    const approx = /(\d{2}\/\d{2})/.exec(season);
    bySeason.set(key, {
      key,
      start: seasonStart,
      big: split ? split[1] : seasonApprox && approx ? approx[1] : season,
      small: split ? `/${split[2]}` : '',
      prefix: seasonApprox ? strings.approxPrefix : '',
      shirts: [entry],
    });
  });

const stops = [...bySeason.values()].sort((a, b) => a.start - b.start);
stops.forEach((stop) => stop.shirts.sort((a, b) => (a.data.igPost ?? 0) - (b.data.igPost ?? 0)));
/*
 * Rendered shirt width per layout (keep in sync with the CSS below):
 *   < 40rem   stop = min(84vw, 26rem); one shirt = 72% of it, two = half each
 *   40–48rem  stop = min(60vw, 30rem)
 *   ≥ 48rem   strip spread: one = 46svh tall → min(46svh × 5/6 ≈ 38svh, ~46vw), two = min(30svh, ~20vw)
 *   ≥ 64rem   pinned: one = 56svh tall → 56svh × 5/6 ≈ 47svh wide, two = 33svh – height-driven, hence vh
 *   (.visual is 5:6, so a height h needs a width of h × 5/6.)
 */
const sizesOne =
  '(min-width: 64rem) min(47vh, 47vw), (min-width: 48rem) min(38vh, 46vw), (min-width: 40rem) min(21.6rem, 43vw), 61vw';
const sizesTwo =
  '(min-width: 64rem) min(33vh, 22vw), (min-width: 48rem) min(30vh, 20vw), (min-width: 40rem) 14rem, 40vw';
const pad = (n: number): string => String(n).padStart(2, '0');
/** Anchor id from the (unique) stop key: „2008/09” → sezon-2008-09, „ok. 70/80” → sezon-ok-70-80. */
const slugify = (key: string): string =>
  key
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase()
    .replace(/ł/g, 'l')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const slugs = new Map<Stop, string>();
stops.forEach((stop, i) => {
  const base = `sezon-${slugify(stop.key) || i + 1}`;
  const taken = new Set(slugs.values());
  slugs.set(stop, taken.has(base) ? `${base}-${i + 1}` : base);
});
const slug = (stop: Stop): string => slugs.get(stop) ?? '';
const competitions = (stop: Stop): string =>
  [...new Set(stop.shirts.map(({ data }) => data.competition).filter(Boolean))].join(' · ');
/**
 * Short teaser from story.pl: whole sentences until ~80 chars (CSS clamps the rest).
 * A sentence ends after ≥3 non-space chars + . ! ? … (so „śp. Andrzeja” doesn't split).
 */
const excerpt = (entry: ShirtEntry): string => {
  const sentences = (entry.data.story?.pl ?? '').split(/(?<=\S{3}[.!?…])\s+(?=[\p{Lu}„])/u);
  return sentences.reduce((out, sentence) => (out.length >= 80 ? out : `${out} ${sentence}`.trim()), '');
};
---

<section
  class="seasons"
  aria-labelledby={labelledby}
  style={`--stops:${stops.length}`}
  data-seasons
>
  <div class="pin">
    <div class="bar">
      <p class="kicker">{strings.kicker}</p>
      <nav class="index" aria-label={strings.navLabel}>
        <ol>
          {
            stops.map((stop, i) => (
              <li>
                <a href={`#${slug(stop)}`} data-stop-link={i}>
                  {stop.prefix && `${stop.prefix} `}
                  {stop.big}
                  {stop.small}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="progress" aria-hidden="true"><span></span></div>
    </div>

    <div class="strip" data-strip>
      <ol class="track" role="list">
        {
          stops.map((stop, i) => {
            const comps = competitions(stop);
            const many = stop.shirts.length > 1;
            return (
              <li class="stop" id={slug(stop)} style={`--i:${i}`} data-count={stop.shirts.length} data-stop>
                <div class="when">
                  <p class="no" aria-hidden="true">
                    {strings.stopLabel} {pad(i + 1)} / {pad(stops.length)}
                  </p>
                  <h3 class="year">
                    {stop.prefix && <span class="prefix">{stop.prefix}</span>}
                    <span class="big">{stop.big}</span>
                    {stop.small && <span class="small">{stop.small}</span>}
                  </h3>
                  {comps && <p class="comps">{comps}</p>}
                </div>

                <div class="shots">
                  {stop.shirts.map((entry) => {
                    const vt = shirtTransitionName(entry.id);
                    const href = shirtHref(entry.id);
                    const { player, number, competition, match } = entry.data;
                    const teaser = excerpt(entry);
                    return (
                      <article class="shot">
                        {/* Pointer shortcut only – the card's link below is the one in the tab order. */}
                        <a
                          class="figure"
                          href={href}
                          tabindex="-1"
                          aria-hidden="true"
                          data-shirt-link
                          data-astro-prefetch="hover"
                        >
                          {/*
                            Static name on purpose: on back-navigation from a detail page (no click
                            happened here) the browser needs a pre-rendered target to morph into.
                            Featured's copies only carry `data-vt`; home.ts moves the name to the
                            clicked element and sets `none` on the others, so it's never duplicated.
                          */}
                          <span class="visual" data-vt={vt} style={`view-transition-name: ${vt}`}>
                            <ShirtFace
                              shirt={entry.data}
                              uid={`sez-${entry.id}`}
                              sizes={many ? sizesTwo : sizesOne}
                            />
                          </span>
                        </a>
                        <div class="card">
                          <h4 class="name">
                            {lastName(player)}
                            <span class="num">
                              <span class="visually-hidden">{strings.number} </span>
                              {number}
                            </span>
                          </h4>
                          {many && competition && <p class="comp">{competition}</p>}
                          {match?.pl && <p class="match">{match.pl}</p>}
                          {teaser && <p class="story">{teaser}</p>}
                          <a class="more" href={href} data-shirt-link data-astro-prefetch="hover">
                            {/* No whitespace between the parts: the arrow stays glued to the last word. */}
                            {strings.open}<span aria-hidden="true">&nbsp;→</span><span class="visually-hidden">: {player}</span>
                          </a>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>

    <div class="foot">
      <ol class="dots" role="list" aria-hidden="true">
        {stops.map((_, i) => <li data-stop-dot={i} />)}
      </ol>
      {/* Prev/next: home.ts wires them (and keeps aria-disabled in sync); hidden without JS like the chips. */}
      <div class="steps">
        <button type="button" class="step" data-step="-1" aria-disabled="true">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14.5 5.5 8 12l6.5 6.5" /></svg>
          <span class="visually-hidden">{strings.prev}</span>
        </button>
        <button type="button" class="step" data-step="1" aria-disabled="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.5 5.5 16 12l-6.5 6.5" /></svg>
          <span class="visually-hidden">{strings.next}</span>
        </button>
      </div>
      <p class="hint" aria-hidden="true">{strings.hint}</p>
    </div>
  </div>

  {/* Pinned layout only: one invisible snap anchor per stop („magnet”, see the CSS below). */}
  <div class="snaps" aria-hidden="true">
    {stops.map((_, i) => <span style={`--i:${i}`} />)}
  </div>
</section>

<style>
  .seasons {
    --stop-w: min(84vw, 26rem);
    --gap: 1rem;
    position: relative;
    background: var(--c-white);
    color: var(--c-ink);
  }

  .pin {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: 2rem 2.5rem;
  }

  .bar {
    display: grid;
    gap: 0.9rem;
    padding-inline: var(--gutter);
  }

  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-red);
  }

  /* Without JS the chips would be dead anchors (the pinned strip is clipped) – home.ts sets data-ready. */
  .seasons:not([data-ready]) :is(.index, .steps) {
    display: none;
  }

  .index ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index a {
    display: inline-block;
    padding: 0.45rem 0.7rem 0.4rem;
    border: 1.5px solid var(--c-red);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-red);
    text-decoration: none;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);

    &:hover,
    &:focus-visible,
    &[aria-current='step'] {
      background: var(--c-red);
      color: var(--c-white);
    }
  }

  .progress,
  .snaps {
    display: none;
  }

  /* ── Base: native horizontal scroll-snap strip, stops centred ── */
  .strip {
    /* offsetParent for home.ts (offsetLeft in scroll coordinates) + query container for the
       track's centring padding (100cqi = the strip's real width, no scrollbar gutter). */
    position: relative;
    container-type: inline-size;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: inline mandatory;
    /* A chip click scrolls the strip into view – keep its top clear of the floating header. */
    scroll-margin-block-start: var(--hdr-space, 0px);
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  /* Flex items stretch: every stop is as tall as the tallest one. The block-end padding keeps
     the floor shadow inside the scroller (overflow-x: auto clips the block axis too). */
  .track {
    display: flex;
    align-items: stretch;
    gap: var(--gap);
    inline-size: max-content;
    margin: 0;
    padding: 0 max(var(--gutter), (100cqi - var(--stop-w)) / 2) 1.5rem;
    list-style: none;
  }

  /* Year block on top, shirt(s) + caption fill the rest (1fr), so equal-height stops line up.
     A query container too: the spread layout below sizes its columns against the stop. */
  .stop {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
    inline-size: var(--stop-w);
    padding-block-start: 1rem;
    border-block-start: 3px solid var(--c-red);
    scroll-snap-align: center;
  }

  /* Year block: its own query container, so the year is sized to always fit its column. */
  .when {
    container-type: inline-size;
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }

  .no,
  .comps {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--c-navy);
  }

  .comps {
    color: var(--c-red);
    text-wrap: balance;
  }

  /* Stacked block: big year, outlined „/09” tucked under its right edge. */
  .year {
    display: grid;
    justify-items: start;
    margin: 0;
    font-family: var(--font-display);
    /* Widest content („70/80” at the 112% stretch peak) ≈ 3.2em → always fits the column. */
    font-size: calc(100cqi / 3.3);
    font-weight: 900;
    font-stretch: 100%;
    line-height: 0.82;
    letter-spacing: -0.02em;
    color: var(--c-red);
    font-variant-numeric: tabular-nums;
  }

  .prefix {
    margin-block-end: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .small {
    justify-self: end;
    margin-block-start: 0.06em;
    font-size: 0.42em;
    font-stretch: 75%;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--c-red);
  }

  /* Two rows shared by every shirt of the stop (subgrid): shirts centred in the free space,
     captions on the bottom edge – aligned with each other and with the neighbouring stops. */
  .shots {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 1rem 0.75rem;
  }

  .shot {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    gap: 1rem;
  }

  /* No subgrid: each shirt is its own column – shirt centred in the free space, caption at the bottom. */
  @supports not (grid-template-rows: subgrid) {
    .shots {
      grid-template-rows: minmax(0, 1fr);
    }

    .shot {
      display: flex;
      flex-direction: column;
      grid-row: auto;

      & .figure {
        margin-block: auto;
      }
    }

    .stop[data-count='1'] .figure {
      align-self: center;
    }
  }

  .figure {
    position: relative;
    align-self: center;
    display: block;
    color: inherit;

    /* Floor shadow the shirt stands on (outside the morphing visual on purpose). */
    &::after {
      content: '';
      position: absolute;
      z-index: -1;
      inset-inline: 10%;
      inset-block-end: -3%;
      block-size: 8%;
      border-radius: 50%;
      background: radial-gradient(closest-side, rgb(5 15 26 / 0.3), transparent);
    }
  }

  .stop[data-count='1'] .figure {
    inline-size: 72%;
    justify-self: center;
  }

  .visual {
    display: block;
    aspect-ratio: 5 / 6;
    inline-size: 100%;
    filter: drop-shadow(0 1rem 1rem rgb(5 15 26 / 0.18));
    transition: transform var(--dur) var(--ease-out);
  }

  /* Flex column: the link sits on the bottom edge even when a sibling caption is taller. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid rgb(5 15 26 / 0.14);
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.4rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.95;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .num {
    color: var(--c-red);
  }

  .comp,
  .match {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    line-height: 1.45;
    text-wrap: balance;
  }

  .comp {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-red);
  }

  .match {
    color: var(--c-navy);
  }

  .story {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: var(--fs-sm);
    line-height: 1.45;
    text-wrap: pretty;
    color: rgb(5 15 26 / 0.82);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  /* Two shirts side by side on a phone: no room for the story – the detail page has it. */
  .stop:not([data-count='1']) .story {
    display: none;
  }

  .more {
    align-self: flex-start;
    margin-block-start: auto;
    padding-block: 0.5rem 0.3rem;
    border-block-end: 1.5px solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-red);
    text-decoration: none;
    transition: color var(--dur-fast);

    &:hover {
      color: var(--c-ink);
    }
  }

  /* Narrow two-up captions: tighter tracking so the link label fits one line where it can. */
  .stop:not([data-count='1']) .more {
    letter-spacing: 0.02em;
  }

  /* Single red ring: 5.4:1 on the white section, no ink halo needed. */
  .figure:focus-visible,
  .more:focus-visible {
    outline-color: var(--c-red);
    box-shadow: none;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-inline: var(--gutter);
  }

  .dots {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;

    & li {
      inline-size: 0.5rem;
      block-size: 0.5rem;
      border-radius: 0.25rem;
      background: rgb(198 16 46 / 0.25);
      transition:
        inline-size var(--dur) var(--ease-out),
        background-color var(--dur-fast);
    }

    & li[data-active] {
      inline-size: 1.5rem;
      background: var(--c-red);
    }
  }

  /* Prev/next season: round red-outline buttons, filled on hover/focus (gold ring from base.css). */
  .steps {
    display: flex;
    gap: 0.5rem;
    margin-inline-start: auto;
  }

  .step {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1.5px solid var(--c-red);
    border-radius: 50%;
    background: transparent;
    color: var(--c-red);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      opacity var(--dur-fast);

    & svg {
      inline-size: 1.25rem;
      block-size: 1.25rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.25;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    &:hover,
    &:focus-visible {
      background: var(--c-red);
      color: var(--c-white);
    }

    /* aria-disabled (not disabled): stays focusable, so focus isn't lost at the first/last stop. */
    &[aria-disabled='true'] {
      opacity: 0.35;
      cursor: default;

      &:hover {
        background: transparent;
        color: var(--c-red);
      }
    }
  }

  .hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-navy);
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover .visual {
      transform: translateY(-3%) rotate(-2deg) scale(1.03);
    }
  }

  @media (min-width: 40rem) {
    .seasons {
      --stop-w: min(60vw, 30rem);
      --gap: 2rem;
    }
  }

  /* ── ≥ 48rem strip: the two-column spread, one season per ~86% of the strip ──
     (The pinned layout below overrides every property set here.) */
  @media (min-width: 48rem) {
    .seasons {
      /* cqi resolves where it's used: the track and the stops – both measure the strip. */
      --stop-w: min(86cqi, 88rem);
      --gap: clamp(1rem, 2vw, 2rem);
    }

    .stop {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: 1.5rem clamp(1.5rem, 4cqi, 4rem);
      padding-block-start: 1.25rem;
    }

    .when {
      grid-area: 1 / 1;
      align-self: start;
    }

    .year {
      /* Fits the column („70/80” ≈ 3.2em) and the viewport height. */
      font-size: min(100cqi / 3.3, 17svh);
    }

    /* One shirt: year top-left, caption bottom-left, shirt alone in the right column.
       .shots/.shot are subgrids so the card and the visual can sit in different columns
       while staying inside one <article> (the morph finds the visual via closest('article')). */
    .stop[data-count='1'] .shots,
    .stop[data-count='1'] .shot {
      grid-area: 1 / 1 / -1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      gap: inherit;
      pointer-events: none;
    }

    .stop[data-count='1'] .figure {
