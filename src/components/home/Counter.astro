---
export interface CounterStrings {
  /** Screen-reader heading; `{n}` is replaced with the count. */
  title: string;
  label: string;
  labelStrong: string;
}

interface Props {
  count: number;
  strings: CounterStrings;
}

const { count, strings } = Astro.props;

// Widest possible digits of the same length – reserves the final width so counting never shifts layout.
const ghost = '8'.repeat(String(count).length);
---

<section class="num" aria-labelledby="num-title" data-reveal>
  <h2 id="num-title" class="visually-hidden">{strings.title.replace('{n}', String(count))}</h2>

  <div class="fig" aria-hidden="true" style={`--target:${count}`}>
    <span class="ghost">{ghost}</span>
    <span class="outline"></span>
    <span class="fill"></span>
  </div>

  <p class="label" aria-hidden="true">{strings.label} <strong>{strings.labelStrong}</strong></p>
</section>

<style>
  .num {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.25rem;
    min-block-size: 100svh;
    padding: 12svh var(--gutter);
    background: var(--c-red);
    color: var(--c-white);
    text-align: center;
  }

  .fig {
    display: inline-grid;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 62%;
    font-size: min(64vw, 44svh);
    line-height: 0.8;
    font-variant-numeric: tabular-nums;

    /* Static path (no JS / reduced motion / finished animation): the real number. */
    --n: var(--target);

    & > * {
      grid-area: 1 / 1;
    }
  }

  /* Reserves the final width; the live digits are generated by a CSS counter. */
  .ghost {
    visibility: hidden;
  }

  .outline,
  .fill {
    counter-reset: n var(--n);

    &::before {
      content: counter(n);
    }
  }

  .outline {
    color: transparent;
    -webkit-text-stroke: clamp(2px, 0.6vw, 6px) var(--c-white);
  }

  .fill {
    color: var(--c-white);
  }

  .label {
    margin: 0;
    max-inline-size: 16ch;
    font-size: var(--fs-lg);
    font-weight: 800;
    font-stretch: 90%;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;

    & strong {
      display: block;
      font-stretch: 125%;
      font-weight: 900;
    }
  }

  @media (min-width: 48rem) {
    .num {
      grid-auto-flow: column;
      gap: 3rem;
      text-align: start;
    }

    .fig {
      font-size: min(34vw, 62svh);
    }

    .label {
      font-size: var(--fs-xl);
    }
  }

  @keyframes count {
    from {
      --n: 0;
    }
    to {
      --n: var(--target);
    }
  }

  @keyframes counter-rise {
    from {
      clip-path: inset(100% 0 0 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Scroll-scrubbed: 0 → 86, then the outline fills from the bottom. */
    @supports (animation-timeline: view()) {
      .fig {
        animation: count linear both;
        animation-timeline: view();
        animation-range: entry 15% cover 45%;
      }

      .fill {
        animation: counter-rise linear both;
        animation-timeline: view();
        animation-range: cover 30% cover 55%;
      }
    }

    /* Fallback: time-based run once the section is on screen (needs JS). */
    @supports not (animation-timeline: view()) {
      @media (scripting: enabled) {
        .num:not(.is-in) .fig {
          --n: 0;
        }

        .num:not(.is-in) .fill {
          clip-path: inset(100% 0 0 0);
        }

        .num.is-in .fig {
          animation: count 1800ms var(--ease-out) both;
        }

        .num.is-in .fill {
          animation: counter-rise 900ms var(--ease-out) 1500ms both;
        }
      }
    }
  }
</style>
