---
/** Red → white sash flip. Its heading names the section that follows (aria-labelledby on that section). */
interface Props {
  title: string;
  id: string;
  kicker?: string;
}

const { title, id, kicker } = Astro.props;
---

<div class="flip" data-reveal>
  <div class="stage">
    <div class="sash" aria-hidden="true"></div>
    <div class="head">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 id={id}>{title}</h2>
    </div>
  </div>
</div>

<style>
  /* Base (no motion / no JS): the flip has already happened – a plain white stage. */
  .flip {
    --tilt: -12deg;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    overflow: clip;
    min-block-size: 70svh;
    background: var(--c-white);
    color: var(--c-red);
  }

  .sash {
    display: none;
  }

  .head {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h2 {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: min(15vw, 22svh);
    font-weight: 900;
    font-stretch: 112%;
    line-height: 0.9;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  @keyframes widen {
    from {
      transform: rotate(var(--tilt)) scaleY(0.06);
    }
    to {
      transform: rotate(var(--tilt)) scaleY(1);
    }
  }

  /* Motion version: red stage, white sash grows until the screen flips to white.
     The red headline is only readable where the sash has reached – the reveal. */
  @media (prefers-reduced-motion: no-preference) and (scripting: enabled) {
    .stage {
      min-block-size: 100svh;
      background: var(--c-red);
    }

    .sash {
      display: block;
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 50%;
      /* Square, so it covers any aspect ratio once rotated: a w×h viewport fits a θ-rotated
         S×S square when S ≥ w·cosθ + h·sinθ and S ≥ w·sinθ + h·cosθ. Worst case is a square
         viewport (cos12° + sin12° ≈ 1.19vmax); 2560×1440 needs 1.10vmax, 390×844 needs 1.07vmax. */
      inline-size: 120vmax;
      block-size: 120vmax;
      margin: -60vmax 0 0 -60vmax;
      background: var(--c-white);
      transform: rotate(var(--tilt)) scaleY(0.06);
    }

    @supports (animation-timeline: view()) {
      .flip {
        block-size: 200svh;
        view-timeline: --flip block;
      }

      .stage {
        position: sticky;
        inset-block-start: 0;
      }

      .sash {
        animation: widen cubic-bezier(0.6, 0, 0.4, 1) both;
        animation-timeline: --flip;
        animation-range: cover 18% cover 58%;
      }
    }

    @supports not (animation-timeline: view()) {
      .sash {
        transition: transform 1200ms var(--ease-in-out);
      }

      .flip.is-in .sash {
        transform: rotate(var(--tilt)) scaleY(1);
      }
    }
  }
</style>
